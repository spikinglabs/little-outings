/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

# The site's address is outings.allo.land; keep the Cloudflare copy out of search results.
https://little-outings.pages.dev/*
  X-Robots-Tag: noindex

# Discover's cards, a tile at a time, loaded by the home page; not pages of their own.
/:lang/ideen/*
  X-Robots-Tag: noindex

# Event and place pages packed for the Pages Functions (src/lib/page-packs.ts); the pages are at
# /<lang>/termine/<id>/ and /<lang>/orte/<id>/.
/packs/*
  X-Robots-Tag: noindex

# Rednote cards and their captions for the admin's Rednote box (src/pages/xhs/); not pages to find.
/xhs/*
  X-Robots-Tag: noindex
