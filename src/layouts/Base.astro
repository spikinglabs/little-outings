---
import "@fontsource/atkinson-hyperlegible/400.css";
import "@fontsource/atkinson-hyperlegible/700.css";
import "@fontsource/barlow-semi-condensed/600.css";
import "@fontsource/barlow-semi-condensed/700.css";
import "@fontsource-variable/bricolage-grotesque/opsz.css";
import "../styles/global.css";
import { LANGS, MAKER_URL, useT, type Lang } from "../lib/i18n";
import { UI_ICON, sprite, svg } from "../lib/icons";
import { FEATURES } from "../content.config";
import { getData } from "../lib/data";
import { ldJson } from "../lib/seo";
import { HOME_KEY, OG, ogBase } from "../lib/og";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  tab?: "explore" | "saved" | "add";
  /** The link preview picture's key (src/lib/og.ts), e.g. eventKey(e); the brand picture otherwise. */
  og?: string;
  /** A ready picture instead, 1200×630 (meetups; functions/m/[id].ts rewrites it and og:url). */
  image?: string;
  noindex?: boolean;
  /** schema.org JSON-LD for this page (src/lib/seo.ts). */
  ld?: unknown;
  /** A file the page's script will fetch, requested together with the page instead of after it. */
  preload?: string;
}
const { lang, title, description, tab, og, image, noindex, ld, preload } = Astro.props;
const t = useT(lang);
const { region } = await getData();
// The "saved" tab is labelled "Mine": it holds the saved list, what was sent and the profile.
const TAB_ICON: Record<string, string> = { explore: UI_ICON.explore, saved: UI_ICON.mine, add: UI_ICON.add };
// Path without the language prefix, so the switcher keeps the reader on the same page.
const rest = Astro.url.pathname.replace(/^\/(de|en|zh)\//, "");
const tabs = [
  ["explore", ""],
  ["saved", "merkliste/"],
  ["add", "mitmachen/"],
] as const;
const pageTitle = title ? `${title} · ${t("siteName")}` : `${t("siteName")} · ${t("tagline")}`;
const site = Astro.site?.toString().replace(/\/$/, "") ?? "";
// One address per page, on the real domain, so little-outings.pages.dev never counts as a copy.
const canonical = `${site}${Astro.url.pathname}`;
const OG_LOCALE: Record<Lang, string> = { de: "de_DE", en: "en_GB", zh: "zh_CN" };
// Link previews: a wide picture for WhatsApp, Signal, Telegram and social sites; a square one for
// WeChat and QQ, which read the itemprop tags and show a small square thumbnail.
const ogTitle = title ?? t("siteName");
const ogDescription = description ?? t("tagline");
const ogImage = `${site}${image ?? `${ogBase(lang, og ?? HOME_KEY)}.png`}`;
const ogSquare = image ? ogImage : `${site}${ogBase(lang, og ?? HOME_KEY)}-sq.png`;
// Strings the browser scripts need, in this language.
const ui = {
  fac: FEATURES.map((f) => [f, t(`features.${f}`)]),
  km: t("km"), approxKm: t("approxKm"), nearby: t("nearby"), save: t("save"), saved: t("saved"),
  answered: t("answered"), answeredCheck: t("answeredCheck"), answeredVote: t("answeredVote"), hintIos: t("install.hintIos"), installMenu: t("install.menu"), installed: t("install.installed"), inboxSoon: t("inboxSoon"), reported: t("report.thanks"), visited: t("visit.thanks"), tipThanks: t("visit.tipThanks"), wentBefore: t("visit.before"),
  askNext: t("chipAsk.next"), askThanks: t("chipAsk.thanks"), askYou: t("chipAsk.you"), askAgain: t("chipAsk.again"), askUndone: t("chipAsk.undone"), langUndone: t("speechAsk.undone"), askVotes: t("chipAsk.votes"), langThanks: t("speechAsk.thanks"), yes: t("yes"), no: t("no"), unsure: t("dunno"),
};
---
<!doctype html>
<html lang={lang} itemscope itemtype="https://schema.org/WebPage">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? t("tagline")} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content={t("siteName")} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OG.w)} />
    <meta property="og:image:height" content={String(OG.h)} />
    <meta property="og:image:alt" content={ogTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta itemprop="name" content={ogTitle} />
    <meta itemprop="description" content={ogDescription} />
    <meta itemprop="image" content={ogSquare} />
    {ld && <script type="application/ld+json" set:html={ldJson(ld)} />}
    {preload && <link rel="preload" href={preload} as="fetch" crossorigin="anonymous" />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#ffcc00" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121314" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Light or dark as chosen under Profile (lo-theme); without a choice the phone's setting decides.
      // Runs before the page paints so a chosen theme never flashes the other one first.
      (function () {
        var c; try { c = localStorage.getItem("lo-theme"); } catch (e) {}
        if (c !== "light" && c !== "dark") return;
        document.documentElement.dataset.theme = c;
        document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) { m.content = c === "dark" ? "#121314" : "#ffcc00"; });
      })();
    </script>
    {!noindex && LANGS.map((l) => <link rel="alternate" hreflang={l === "zh" ? "zh-Hans" : l} href={`${site}/${l}/${rest}`} />)}
    {/* Readers with another language land on German; on the home page the root picks one from the browser. */}
    {!noindex && <link rel="alternate" hreflang="x-default" href={rest ? `${site}/de/${rest}` : `${site}/`} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href={`/${lang}/manifest.webmanifest`} />
    <script is:inline>
      // Catch Chrome's install offer as early as possible; the page script may load after it fires.
      addEventListener("beforeinstallprompt", function (e) { e.preventDefault(); window.__loInstall = e; dispatchEvent(new Event("lo:installable")); });
      // Safety net: if the page arrived without its styles (an outdated saved copy), stop the service
      // worker, drop every saved copy, fetch the style files afresh and load the page once more.
      addEventListener("load", function () {
        if (getComputedStyle(document.documentElement).getPropertyValue("--ink")) return;
        try { if (sessionStorage.getItem("lo-restyle-v5")) return; sessionStorage.setItem("lo-restyle-v5", "1"); } catch (e) { return; }
        var sheets = [].map.call(document.querySelectorAll('link[rel="stylesheet"]'), function (l) { return l.href; });
        var sw = navigator.serviceWorker;
        Promise.all([
          sw ? sw.getRegistrations().then(function (rs) { return Promise.all(rs.map(function (r) { return r.unregister(); })); }) : 0,
          window.caches ? caches.keys().then(function (ks) { return Promise.all(ks.map(function (k) { return caches.delete(k); })); }) : 0,
        ].concat(sheets.map(function (h) { return fetch(h, { cache: "reload" }).catch(function () {}); })))
          .catch(function () {}).then(function () { location.reload(); });
      });
    </script>
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content={t("siteName")} />
    <meta name="mobile-web-app-capable" content="yes" />
  </head>
  <body data-ui={JSON.stringify(ui)} data-lang={lang} data-home={region.center} data-towns={JSON.stringify(region.towns.map((x) => [x.name, x.lat, x.lon]))}>
    <Fragment set:html={sprite()} />
    <div class="flag" aria-hidden="true"></div>
    <div class="app">
      {process.env.DEMO && <p class="demo">{t("demo")}</p>}
      <header class="top">
        <a class="brand" href={`/${lang}/`}>
          <span class="brand-mark" set:html={svg(UI_ICON.brand)} />
          <span>{t("siteName")}</span>
        </a>
        <nav class="topnav" aria-label={t("siteName")}>
          {tabs.map(([k, p]) => <a href={`/${lang}/${p}`} aria-current={tab === k ? "page" : undefined} data-tab={k}>{t(`tabs.${k}`)}</a>)}
        </nav>
        <div class="top-right">
          <nav class="lang" aria-label="Sprache · Language · 语言">
            {LANGS.map((l) => (
              <a href={`/${l}/${rest}`} hreflang={l} lang={l} aria-current={l === lang ? "true" : undefined} title={useT(l)("langName")}>
                {l === "zh" ? "中" : l.toUpperCase()}
              </a>
            ))}
          </nav>
        </div>
      </header>
      <aside class="app-hint" data-app-hint hidden>
        <span class="app-hint-icon" aria-hidden="true">📱</span>
        <span class="app-hint-text" data-app-hint-text>{t("install.hint")}</span>
        <button type="button" class="app-hint-go" data-app-hint-go hidden>{t("install.short")}</button>
        <button type="button" class="app-hint-x" data-app-hint-x aria-label={t("install.dismiss")}>×</button>
      </aside>
      <main>
        <slot />
      </main>
      <footer class="foot">
        <p>{t("footer")} <a href={`/${lang}/daten`}>{t("about.link")}</a> · <a href={`/${lang}/impressum`}>{t("legal.link")}</a></p>
        <p class="maker" set:html={t("byLine", { maker: `<a href="${MAKER_URL}" target="_blank" rel="noopener">Spiking Labs</a>` })} />
        <p class="install" data-install hidden>
          <button type="button" class="btn install-btn" data-install-btn>{t("install.button")}</button>
          <span class="install-how" data-install-how role="status" hidden></span>
        </p>
        <slot name="footer" />
      </footer>
    </div>
    <nav class="tabs" aria-label={t("siteName")}>
      {tabs.map(([k, p]) => (
        <a href={`/${lang}/${p}`} aria-current={tab === k ? "page" : undefined} data-tab={k}>
          <Fragment set:html={svg(TAB_ICON[k])} />
          <span>{t(`tabs.${k}`)}</span>
        </a>
      ))}
    </nav>
    <script>
      import "../scripts/app";
    </script>
  </body>
</html>
