---
// One "still missing" question. GapBox lists them for an outing; Mitmachen clones one per kind in the browser.
// A parent rarely has to type: what another parent already said shows with one tap to confirm
// (it counts as a second, agreeing answer), likely spots are small chips, and the map is one icon
// beside the text box. All in view at once, but compact: no extra "I know" step (L found it fiddly).
import type { T } from "../lib/i18n";
import type { Ask } from "../lib/types";

interface Props { t: T; gapKey: string; type: string; feature?: string; asks?: Ask[]; guesses?: Ask[] }
const { t, gapKey: key, type, feature, asks = [], guesses = [] } = Astro.props;
const withInput = new Set(["where", "time", "price", "hours"]);
const q = type === "fac" ? t("q.fac", { f: t(`features.${feature}`) }) : t(`q.${type}`);
const inputId = `g-${key.replace(/:/g, "-")}`;
const said = asks;
// A guess another parent already said shows once, as their answer.
const plain = (v: string) => v.toLowerCase().replace(/[^\p{L}\p{N}]+/gu, "");
const fresh = guesses.filter((g) => !said.some((a) => plain(a.value) === plain(g.value)));
const shown = (a: Ask) => (type === "price" && /^(free|frei|kostenlos|gratis|免费)$/i.test(a.value) ? t("free") : a.value);
const pick = (a: Ask) => (a.at ? { "data-lat": a.at.lat, "data-lon": a.at.lon, "data-place": a.at.place } : {});

---
<form class="gap" data-gap={key} novalidate>
  <span class="gap-tag">{t(`gapLabel.${type}`)}</span>
  {withInput.has(type) ? <label for={inputId}><b>{q}</b></label> : <b>{q}</b>}
  {withInput.has(type) ? (
    <div class="gap-form gap-stack">
      {said.length > 0 && (
        <div class="gap-picks">
          <small>{said.length > 1 ? t("gapAsk.saidMany") : t("gapAsk.said")}</small>
          {said.map((a) => <button class="chip pick" type="submit" name="answer" value={a.value} data-agrees={said.length === 1 ? "" : undefined} {...pick(a)}><span aria-hidden="true">✓</span> {shown(a)}</button>)}
        </div>
      )}
      {([["gapAsk.ai", fresh.filter((a) => a.ai)], ["gapAsk.guess", fresh.filter((a) => !a.ai && !a.usual)], ["gapAsk.usual", fresh.filter((a) => a.usual)]] as const).map(([label, list]) => list.length > 0 && (
        <div class="gap-picks">
          <small>{t(label)}</small>
          <div class="gap-chips">
            {list.map((a) => <button class="chip guess" type="submit" name="answer" value={a.value} title={a.value} {...pick(a)}><span aria-hidden="true">📍</span><span>{a.value}</span></button>)}
          </div>
        </div>
      ))}
      <div class="gap-row">
        {type === "price" && <button class="chip" type="submit" name="answer" value="free">{t("free")}</button>}
        <input id={inputId} name="text" placeholder={t(`ph.${type}`)} data-ph-named={type === "where" ? t("gapAsk.mapName") : undefined} autocomplete="off" />
        {type === "where" && <button class="chip map-pick" type="button" data-map-pick aria-label={t("gapAsk.map")} title={t("gapAsk.map")}>🗺️</button>}
        <button class="btn" type="submit">{t("send")}</button>
      </div>
      {type === "where" && (
        <>
          <div class="gap-map" hidden data-finding={t("gapAsk.finding")} data-no-addr={t("gapAsk.noAddr")}>
            <small>{t("gapAsk.mapHint")}</small>
            <div class="map" />
            <p class="gap-map-addr" aria-live="polite" hidden />
          </div>
          <input type="hidden" name="lat" />
          <input type="hidden" name="lon" />
        </>
      )}
    </div>
  ) : (
    <div class="gap-form">
      <button class="chip" type="submit" name="answer" value="yes">{t("yes")}</button>
      <button class="chip" type="submit" name="answer" value="no">{t("no")}</button>
      <button class="chip" type="submit" name="answer" value="unsure">{t("dunno")}</button>
    </div>
  )}
</form>
