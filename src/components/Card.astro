---
// One card for an event or a place. The data-* attributes drive the filters in the browser.
import Stamp from "./Stamp.astro";
import { tr, type T } from "../lib/i18n";
import { ageText, areaName, dateRange, germanName, isFarm, isFree, nameOf, parentInput, pathFor, shortDate, townName } from "../lib/format";
import { icon } from "../lib/icons";
import { rowFor } from "../lib/features";
import { getData } from "../lib/data";
import type { Item } from "../lib/types";
import { runsLong } from "../lib/running";

interface Props { item: Item; t: T; hidden?: boolean }
const { item, t, hidden } = Astro.props;
const lang = t.lang;
const { region, placeById, events } = await getData();
const place = item.type === "event" && item.place ? placeById.get(item.place) : item.type === "place" ? item : undefined;
const facilities = place?.facilities ?? {};
const yes = Object.entries(facilities).filter(([, v]) => v.status === "yes").map(([k]) => k);
const tags = item.type === "event" ? item.tags : [];
const name = nameOf(item, lang);
const german = germanName(item, lang);
// "Do I need German?" only matters to readers who don't read German.
const speech = lang !== "de" && item.type === "event" ? item.language : undefined;
const guessed = item.type === "event" && item.languageFrom === "guess";
const town = townName(item.town, lang, region.towns);
const where = item.type === "event" ? [item.venue, town].filter(Boolean).join(", ") : [t(`kinds.${item.kind}`), areaName(item, lang, region.towns)].join(" · ");
// A long run (an exhibition) reads by when it ends: "until 6 Dec", not since when it started.
const long = item.type === "event" && runsLong(item.start, item.end);
const meta = item.type === "event"
  ? [long ? t("runsUntil", { date: shortDate(t, item.end) }) : item.end !== item.start ? dateRange(t, item) : "", item.time, where].filter(Boolean).join(" · ")
  : where;
// Once parents have added to a place, say so instead of "not checked yet" (the source is on its page).
const answers = parentInput(item);
const soon = item.type === "place" ? events.filter((e) => e.place === item.id).length : 0;
const prec = item.geo.precision;
const search = [
  item.type === "event" ? (typeof item.title === "string" ? item.title : Object.values(item.title).join(" ")) : item.name,
  item.type === "place" ? item.names?.zh : undefined,
  item.type === "event" ? item.venue : t(`kinds.${item.kind}`), item.town, town, item.type === "place" ? item.district : undefined, ...tags.map((g) => t(`tags.${g}`)),
].filter(Boolean).join(" ").toLowerCase();
---
<article
  class="item"
  hidden={hidden}
  data-id={item.id}
  data-type={item.type}
  data-kind={place?.kind}
  data-start={item.type === "event" ? item.start : undefined}
  data-end={item.type === "event" ? item.end : undefined}
  data-long={long ? "1" : undefined}
  data-time={item.type === "event" ? item.time : undefined}
  data-lat={item.geo.lat}
  data-lon={item.geo.lon}
  data-precision={prec}
  data-indoor={item.indoor ? "1" : undefined}
  data-free={isFree(item) ? "1" : undefined}
  data-farm={isFarm(item, place) ? "1" : undefined}
  data-feat={[...yes, ...tags, ...(item.type === "event" && !tags.length ? ["other"] : []), ...(item.type === "event" && item.language && item.language !== "de" ? ["nogerman"] : [])].join(" ")}
  data-verified={item.trust.level === "verified" ? "1" : undefined}
  data-q={search}
>
  <Stamp item={item} t={t} />
  <div class="item-body">
    <h3><a href={pathFor(lang, item)}>{name}</a></h3>
    {german && <div class="de-name" lang="de">{german}</div>}
    <div class="meta">{meta}<span data-km></span>{item.type === "place" && item.rating && ` · ★ ${item.rating.stars.toLocaleString(t.locale)}`}</div>
    {item.type === "place" && (
      // The kind's facilities as key:digit (1 = yes); app.ts draws the icons once the card is on screen.
      // Thousands of cards each carrying seven labelled icons made every list page heavy.
      <div class="frow" data-fac={rowFor(place!.kind).map((f) => `${f}:${facilities[f]?.status === "yes" ? 1 : 0}`).join(" ")} />
    )}
    <div class="pills">
      {long && <span class="pill last" data-last hidden>{t("lastChance")}</span>}
      {speech && <span class:list={["pill", "speech", speech]}>{guessed ? t("speechGuess", { s: t(`speech.${speech}`) }) : t(`speech.${speech}`)}</span>}
      {(prec === "venue" || prec === "area") && <span class="pill loc">📍 {t(`locPill.${prec}`)}</span>}
      {item.indoor && <span class="pill rain">{t("indoorPill")}</span>}
      {isFree(item) && <span class="pill free">{t("free")}</span>}
      {item.ages && <span class="pill">{ageText(t, item.ages)}</span>}
      {tags.slice(0, 2).map((g) => <span class="pill">{t(`tags.${g}`)}</span>)}
    </div>
    <div class="trust">
      {soon > 0 ? <b>{t("soonAt", { n: soon })}</b>
        : answers > 0 && item.trust.level === "community" ? <b>{t("trust.parents", { n: answers })}</b>
        : item.trust.level === "verified" ? <><b>{t("trust.verified")}</b>{item.trust.source && ` · ${tr(item.trust.source, lang)}`}</>
        : item.trust.level === "official" ? <>{t("trust.official")}{item.trust.source && ` · ${tr(item.trust.source, lang)}`}</>
        : item.trust.source ? t("trust.from", { source: tr(item.trust.source, lang) })
        : t("trust.community")}
    </div>
  </div>
  <button class="save" type="button" data-save={item.id} aria-pressed="false" aria-label={t("save")} set:html={icon("u", "saved")} />
</article>
