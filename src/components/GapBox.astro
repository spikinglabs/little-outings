---
// "Still missing": one small question per gap. Answers go to the inbox; two matching answers go live.
import { gapsOf } from "../lib/gaps";
import type { T } from "../lib/i18n";
import type { Item } from "../lib/types";

interface Props { item: Item; t: T; compact?: boolean }
const { item, t, compact } = Astro.props;
const gaps = gapsOf(item);
const withInput = new Set(["where", "time", "price", "hours"]);
---
{gaps.length > 0 && (
  <div class:list={[!compact && "help"]}>
    {!compact && <h2>{t("gapsTitle")}</h2>}
    {!compact && <p>{t("gapsSub")}</p>}
    {gaps.map((g) => {
      const q = g.type === "fac" ? t("q.fac", { f: t(`features.${g.feature}`) }) : t(`q.${g.type}`);
      const key = `${item.id}:${g.type}${g.feature ? `:${g.feature}` : ""}`;
      const inputId = `g-${key.replace(/:/g, "-")}`;
      return (
        <form class="gap" data-gap={key} novalidate>
          <span class="gap-tag">{t(`gapLabel.${g.type}`)}</span>
          {withInput.has(g.type) ? <label for={inputId}><b>{q}</b></label> : <b>{q}</b>}
          <div class="gap-form">
            {withInput.has(g.type) ? (
              <>
                {g.type === "price" && <button class="chip" type="submit" name="answer" value="free">{t("free")}</button>}
                <input id={inputId} name="text" placeholder={t(`ph.${g.type}`)} autocomplete="off" />
                <button class="btn" type="submit">{t("send")}</button>
              </>
            ) : (
              <>
                <button class="chip" type="submit" name="answer" value="yes">{t("yes")}</button>
                <button class="chip" type="submit" name="answer" value="no">{t("no")}</button>
                <button class="chip" type="submit" name="answer" value="unsure">{t("dunno")}</button>
              </>
            )}
          </div>
        </form>
      );
    })}
  </div>
)}
