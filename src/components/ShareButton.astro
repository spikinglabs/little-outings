---
// "Share" on event and place pages: the phone's share sheet (WhatsApp, WeChat, Signal …) with a short
// text that names the outing and the site; browsers without one copy text and link. The link preview
// picture comes from the page's og tags (src/lib/og.ts). The click handler is in src/scripts/app.ts.
import type { T } from "../lib/i18n";
import { UI_ICON, svg } from "../lib/icons";

interface Props { title: string; lines: (string | undefined | false)[]; t: T }
const { title, lines, t } = Astro.props;
const text = [title, ...lines.filter(Boolean), t("share.via")].join("\n");
---
<button class="btn" type="button" data-share-page data-title={title} data-text={text} data-done={t("share.pageCopied")}>
  <Fragment set:html={svg(UI_ICON.share, 'stroke-width="2" width="18" height="18"')} /><span data-share-label>{t("share.page")}</span>
</button>
