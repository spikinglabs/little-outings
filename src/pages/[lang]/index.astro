---
// Entdecken: "What shall we do with the kids today?" One list of ideas: events on the chosen day
// and places that are good any time, mixed and nearest first. Every card is rendered; the filter
// script shows the ones that match the chosen day, distance and filters, a page at a time.
import Base from "../../layouts/Base.astro";
import Card from "../../components/Card.astro";
import Stamp from "../../components/Stamp.astro";
import { LANGS, tr, useT, type Lang } from "../../lib/i18n";
import { getData } from "../../lib/data";
import { pathFor, townName } from "../../lib/format";
import { KINDS, TAGS } from "../../content.config";
import { KIND_ICON, UI_ICON, svg } from "../../lib/icons";
import OutingsMap from "../../islands/OutingsMap";
import { mapCenter } from "../../lib/pins";

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const data = await getData();
const { region, events, places, placeById } = data;
// Events without any position can't be placed near anyone; they live on the tasks page.
const listed = events.filter((e) => e.geo.precision !== "unknown");
// Tip candidates: checked events at an exact spot, farms first. The script picks the first visible one.
const tips = listed
  .filter((e) => e.trust.level === "verified" && e.geo.precision === "exact")
  .sort((a, b) => Number(placeById.get(b.place ?? "")?.kind === "farm") - Number(placeById.get(a.place ?? "")?.kind === "farm"));
// Kinds of place in their fixed order (KINDS), when there is at least one.
const presentKinds = KINDS.filter((k) => places.some((p) => p.kind === k));
// Event types that at least one listed event has, most common first; "other" for events with none.
const presentTags = TAGS.map((g) => [g, listed.filter((e) => e.tags.includes(g)).length] as const)
  .filter(([, n]) => n > 0).sort((a, b) => b[1] - a[1]).map(([g]) => g as string)
  .concat(listed.some((e) => !e.tags.length) ? ["other"] : []);
const whenKeys = ["today", "tomorrow", "weekend", "soon"];
const whenIn = t.group("whenIn");
const pluralUi = { nEvents: t.group("nEvents"), nPlaces: t.group("nPlacesAny"), tip: t("tip"), whenIn, mapShow: t("mapShow"), mapHide: t("mapHide"), areaBack: t("mapAreaBack"), showMore: t("mapShowMore"), locNone: t("locNone") };
const homes = region.towns;
// The map shows whatever the filters show (explore.ts tells it which ids).
const mapLabels = { ...(t.group("nEvents") as { one: string; other: string }), more: t("mapMore") };
---
<Base lang={lang} tab="explore">
  <section class="ask">
    <h1 set:html={t("ask", { when: `<span data-when-word>${whenIn.weekend}</span>` })} />
    <label class="search">
      <span class="sr-only">{t("search")}</span>
      <Fragment set:html={svg(UI_ICON.search, 'stroke-width="2"')} />
      <input id="q" type="search" placeholder={t("searchPh")} autocomplete="off" />
    </label>
    <div class="when" role="group">
      {whenKeys.map((k) => <button type="button" data-when={k} aria-pressed={k === "weekend" ? "true" : "false"}>{t(`when.${k}`)}</button>)}
    </div>
    <div class="filters" role="group">
      <label class="chip">📍 {t("near")}
        <select id="home" aria-label={t("near")}>
          {homes.map((h) => <option value={h.name} selected={h.name === region.center}>{townName(h.name, lang, homes)}</option>)}
        </select>
      </label>
      <button class="chip loc" type="button" data-locate aria-label={t("locate")} title={t("locate")}><Fragment set:html={svg(UI_ICON.locate, 'stroke-width="2"')} /></button>
      <button class="chip rain" type="button" data-flag="rain" aria-pressed="false">{t("filters.rain")}</button>
      <button class="chip" type="button" data-flag="farm" aria-pressed="false">{t("filters.farm")}</button>
      <button class="chip" type="button" data-flag="free" aria-pressed="false">{t("filters.free")}</button>
      <button class="chip" type="button" data-flag="animals" aria-pressed="false">{t("filters.animals")}</button>
      <button class="chip" type="button" data-flag="changing" aria-pressed="false">{t("filters.changing")}</button>
      {lang !== "de" && <button class="chip" type="button" data-flag="nogerman" aria-pressed="false">{t("filters.nogerman")}</button>}
      <label class="chip">{t("filters.age")}
        <select id="age" aria-label={t("filters.age")}>
          <option value="">{t("filters.ageAll")}</option>
          <option value="0-2">0–2</option><option value="3-5">3–5</option><option value="6-9">6–9</option><option value="10-18">10+</option>
        </select>
      </label>
      <label class="chip">{t("filters.radius")}
        <select id="radius" aria-label={t("filters.radius")}>
          <option value="10">10 km</option><option value="30" selected>30 km</option><option value="60">60 km</option><option value="100">100 km</option>
        </select>
      </label>
    </div>
    <p class="loc-msg small" role="status" data-loc-msg hidden></p>
  </section>

  <div class="map-bar">
    <button class="map-btn" type="button" data-map-toggle aria-expanded="false" aria-controls="explore-map">
      <Fragment set:html={svg(UI_ICON.map, 'stroke-width="2"')} /><span data-map-label>{t("mapShow")}</span>
    </button>
  </div>
  <div class="mapwrap explore-map" id="explore-map" hidden>
    <OutingsMap client:only="preact" pinsUrl={`/${lang}/pins.json`} center={mapCenter(data)} towns={homes.map((x) => [x.name, x.lat, x.lon])} locale={t.locale} labels={mapLabels} />
    <div class="legend">
      <span><i style="background:#ffcc00"></i>{t("legend.event")}</span>
      <span><i style="background:#6f4a2a"></i>{t("legend.place")}</span>
      <span><i style="border:2px dashed currentColor"></i>{t("legend.approx")}</span>
      <span><i style="background:rgb(111 74 42 / .12);border:1px dashed #6f4a2a;border-radius:50%"></i>{t("legend.area")}</span>
      <span><i style="border:1px dotted currentColor"></i>{t("legend.radius")}</span>
    </div>
  </div>

  <p class="area-note" data-area-note hidden>{t("mapAreaOn")} <button type="button" class="link-btn" data-area-reset></button></p>

  {tips.map((e) => (
    <a class="tip" href={pathFor(lang, e)} data-tip={e.id} hidden>
      <Stamp item={e} t={t} />
      <div>
        <div class="kicker" data-tip-kicker></div>
        <h2>{tr(e.title, lang)}</h2>
        <p>{[e.venue, townName(e.town, lang, homes), e.time].filter(Boolean).join(" · ")}<span data-km></span></p>
      </div>
    </a>
  ))}

  <section class="section" aria-labelledby="ideas-h">
    <div class="section-head"><h2 id="ideas-h">{t("ideas")}</h2><p data-count aria-live="polite"></p></div>
    <div class="filters kinds" role="group" aria-label={t("ideasKinds")}>
      <button class="chip" type="button" data-kind-chip="" aria-pressed="true">{t("allKinds")} <span class="n" data-n></span></button>
      <button class="chip" type="button" data-kind-chip="event" aria-pressed="false"><span class="dot-ev" aria-hidden="true"></span> {t("kindEvents")} <span class="n" data-n></span></button>
      {presentKinds.map((k) => (
        <button class="chip" type="button" data-kind-chip={k} aria-pressed="false"><Fragment set:html={svg(KIND_ICON[k])} /> {t(`kinds.${k}`)} <span class="n" data-n></span></button>
      ))}
    </div>
    <div class="filters types" role="group" aria-label={t("eventTypes")} data-types hidden>
      <button class="chip" type="button" data-tag-chip="" aria-pressed="true">{t("allTypes")} <span class="n" data-n></span></button>
      {presentTags.map((g) => <button class="chip" type="button" data-tag-chip={g} aria-pressed="false">{t(`tags.${g}`)} <span class="n" data-n></span></button>)}
    </div>
    <div class="grid ideas" id="ideas">
      <div class="empty" data-empty hidden>{t("noIdeas")}</div>
    </div>
    <!-- Every card waits here, outside the page, until the filters show it: a few thousand cards
         in the live page made phones slow to open and to switch back to. -->
    <template id="ideas-pool">
      {listed.map((e) => <Card item={e} t={t} hidden />)}
      {places.map((p) => <Card item={p} t={t} hidden />)}
    </template>
    <button class="more-btn" type="button" data-more hidden></button>
  </section>
  {events.length + places.length === 0 && <p class="empty">{t("empty")}</p>}
  <script is:inline type="application/json" id="explore-ui" set:html={JSON.stringify(pluralUi)} />
  <script>
    import "../../scripts/explore";
  </script>
</Base>
