---
// Entdecken: "What shall we do with the kids today?" One list of ideas: events on the chosen day
// and places that are good any time, mixed and nearest first. Every card is rendered; the filter
// script shows the ones that match the chosen day, distance and filters, a page at a time.
import Base from "../../layouts/Base.astro";
import Stamp from "../../components/Stamp.astro";
import { LANGS, MAKER_URL, tr, useT, type Lang } from "../../lib/i18n";
import { getData, getWeather, TODAY } from "../../lib/data";
import { pathFor, townName } from "../../lib/format";
import { KINDS, TAGS } from "../../content.config";
import { KIND_ICON, UI_ICON, svg } from "../../lib/icons";
import OutingsMap from "../../islands/OutingsMap";
import { mapCenter } from "../../lib/pins";
import { tileOf } from "../../lib/tiles";
import { siteLd } from "../../lib/seo";
import { townStates, type Period } from "../../lib/holidays";
import schoolHolidays from "../../../data/school-holidays.json";
import { editionTowns, liveEdition } from "../../lib/weekend-data";
import { addDays } from "../../lib/weekend";
import { seasonPages, seasonPath } from "../../lib/seasons";
import { rednoteSets } from "../../lib/rednote-data";

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const data = await getData();
const { region, events, places, placeById } = data;
// Events without any position can't be placed near anyone; they live on the tasks page.
const listed = events.filter((e) => e.geo.precision !== "unknown");
// Tip candidates: checked events at an exact spot, farms first. The script picks the first visible one.
const tips = listed
  .filter((e) => e.trust.level === "verified" && e.geo.precision === "exact")
  .sort((a, b) => Number(placeById.get(b.place ?? "")?.kind === "farm") - Number(placeById.get(a.place ?? "")?.kind === "farm"));
// Kinds of place in their fixed order (KINDS), when there is at least one.
const presentKinds = KINDS.filter((k) => places.some((p) => p.kind === k));
// Event types that at least one listed event has, most common first; "other" for events with none.
const presentTags = TAGS.map((g) => [g, listed.filter((e) => e.tags.includes(g)).length] as const)
  .filter(([, n]) => n > 0).sort((a, b) => b[1] - a[1]).map(([g]) => g as string)
  .concat(listed.some((e) => !e.tags.length) ? ["other"] : []);
const whenKeys = ["today", "tomorrow", "weekend", "soon"];
const whenIn = t.group("whenIn");
// School holidays per state, from the build day on; the script shows the "Holidays" choice for the home town.
const buildDay = new Date().toISOString().slice(0, 10);
const states = townStates(region.towns);
const holidays = {
  towns: states,
  periods: Object.fromEntries(Object.entries(schoolHolidays.states as Record<string, Period[]>)
    .filter(([s]) => Object.values(states).includes(s))
    .map(([s, ps]) => [s, ps.filter((p) => p.end >= buildDay)])),
  label: t.group("holiday"), labelIn: t.group("holidayIn"),
};
// Season chips (content/seasons.yaml) for seasons with at least one idea; explore.ts shows each in its weeks.
// Chinese families' own occasions come first on the Chinese pages.
const pages = seasonPages(data.seasons);
const seasons = data.seasons.seasons
  .filter((s) => listed.some((e) => e.seasons?.includes(s.id)) || (s.kinds?.length && data.places.some((p) => s.kinds!.includes(p.kind))))
  .sort((a, b) => (lang === "zh" ? Number(!!b.zh_first) - Number(!!a.zh_first) : 0))
  .map((s) => ({
    id: s.id, chip: s.chip, label: `${s.emoji} ${tr(s.label, lang)}`,
    add: s.add ? tr(s.add, lang) : t("season.add"), share: s.share ? tr(s.share, lang) : t("season.share"),
    shareText: s.share_text ? tr(s.share_text, lang) : t("season.shareText"),
    hub: s.page && pages.some((p) => p.season.id === s.id) ? { href: seasonPath(lang, s), label: tr(s.page.hub, lang) } : undefined,
  }));
// Shortcuts next to "Show on map", for the home town (explore.ts picks it): the weekend edition every
// day, marked new from Friday to Sunday, and a season's page in its weeks (Christmas markets, Karneval).
// Every edition town has its page, even before its first edition, so the link always leads somewhere.
const weekendLinks = Object.fromEntries(editionTowns().map((w) => {
  const live = liveEdition(w.editions, TODAY);
  return [w.name, { href: `/${lang}/wochenende/${w.slug}/`, until: live ? addDays(live.weekend, 1) : "" }];
}));
const seasonLinks = data.seasons.seasons.filter((s) => s.page && pages.some((p) => p.season.id === s.id)).map((s) => ({
  id: s.id, label: `${s.emoji} ${tr(s.page!.nav ?? s.label, lang)}`, window: s.page!.link!, hub: seasonPath(lang, s),
  towns: Object.fromEntries(pages.filter((p) => p.season.id === s.id).map((p) => [p.file.town, seasonPath(lang, s, p.file.slug)])),
}));
// The next days' weather per town, from the nightly build (no request from the reader's phone).
const weather = await getWeather();
const pluralUi = { nEvents: t.group("nEvents"), nPlaces: t.group("nPlacesAny"), tip: t("tip"), whenIn, mapShow: t("mapShow"), mapHide: t("mapHide"), areaBack: t("mapAreaBack"), showMore: t("mapShowMore"), locNone: t("locNone"), loadFail: t("loadFail"), noneHere: t("noneHere"), holidays, seasons: seasons.map(({ id, chip, shareText }) => ({ id, chip, shareText })), links: { weekend: weekendLinks, seasons: seasonLinks }, mapShort: [t("mapShowShort"), t("mapHideShort")], copied: t("season.copied"), weather, wx: t.group("wx") };
const homes = region.towns;
// Town picker rows, A–Z in the reader's language (Düsseldorf next to Dortmund, 杜塞尔多夫 by pinyin).
// keys: every name a parent might type, lowercased and without accents (koln finds Köln, 科隆 finds it too).
const fold = (s: string) => s.normalize("NFD").replace(/\p{M}/gu, "").replace(/ß/g, "ss").toLowerCase();
const collator = new Intl.Collator(t.locale);
const towns = homes.map((h) => ({ name: h.name, label: townName(h.name, lang, homes), keys: [h.name, h.en, h.zh].filter(Boolean).map((x) => fold(x!)).join("|") }))
  .sort((a, b) => collator.compare(a.label, b.label));
// The map shows whatever the filters show (explore.ts tells it which ids).
const mapLabels = {
  ...(t.group("nEvents") as { one: string; other: string }), more: t("mapMore"), here: t("legend.here"),
  places: t.group("nPlacesAny") as { one?: string; other: string }, touch: t("mapTouch"), zoom: t("mapZoom"), zoomMac: t("mapZoomMac"),
  locate: t("locate"), close: t("mapClose"), save: t("save"),
  toilets: {
    show: t("toiletsNear.mapShow"), hide: t("toiletsNear.mapHide"), toilets: t("toiletsNear.toilets"), changing: t("toiletsNear.changing"),
    water: t("toiletsNear.water"), table: t("toiletsNear.table"), free: t("toiletsNear.free"), paid: t("toiletsNear.paid"),
    wheelchair: t("toiletsNear.wheelchair"), customers: t("toiletsNear.customers"), route: t("toiletsNear.route"),
  },
};
// What search results and AI answers show for the home page.
const description = t("homeDescription", { events: listed.length, places: places.length });
const site = Astro.site?.toString().replace(/\/$/, "") ?? "";
---
<Base lang={lang} tab="explore" preload={`/${lang}/ideen/${tileOf(...mapCenter(data))}/`} description={description} ld={siteLd({ site, url: `${site}/${lang}/`, name: t("siteName"), description, lang, maker: MAKER_URL })}>
  <section class="ask">
    <h1 set:html={t("ask", { when: `<span data-when-word>${whenIn.weekend}</span>` })} />
    <label class="search">
      <span class="sr-only">{t("search")}</span>
      <Fragment set:html={svg(UI_ICON.search, 'stroke-width="2"')} />
      <input id="q" type="search" placeholder={t("searchPh")} autocomplete="off" />
    </label>
    <div class="when" role="group">
      {whenKeys.map((k) => <>
        <button type="button" data-when={k} aria-pressed={k === "weekend" ? "true" : "false"}>{t(`when.${k}`)}</button>
        {k === "weekend" && <button type="button" data-when="holiday" aria-pressed="false" hidden></button>}
      </>)}
    </div>
    <!-- The chosen days' weather, and a nudge toward ideas that suit it (explore.ts). Hidden without a forecast. -->
    <div class="wx" data-wx hidden>
      <p class="wx-days" data-wx-days></p>
      <p class="wx-tip small"><span data-wx-tip></span>
        <button class="chip" type="button" data-flag="rain" data-wx-btn="roof" aria-pressed="false" hidden>{t("wx.onlyRoof")}</button>
        <button class="chip" type="button" data-flag="outdoor" data-wx-btn="out" aria-pressed="false" hidden>{t("wx.onlyOut")}</button>
        <button class="chip" type="button" data-wx-btn="water" aria-pressed="false" hidden>{t("wx.onlyWater")}</button>
        <a class="wx-by" href="https://open-meteo.com/" target="_blank" rel="noopener">{t("wx.by")}</a>
      </p>
    </div>
    <div class="filters" role="group">
      <button class="chip town-btn" type="button" id="home" value={region.center} aria-haspopup="dialog">📍 {t("near")} <b data-home-name>{townName(region.center, lang, homes)}</b><span class="caret" aria-hidden="true">▾</span></button>
      <button class="chip loc" type="button" data-locate aria-label={t("locate")} title={t("locate")}><Fragment set:html={svg(UI_ICON.locate, 'stroke-width="2"')} /></button>
      {seasons.map((s) => <button class="chip season" type="button" data-season={s.id} aria-pressed="false" hidden>{s.label}</button>)}
      <button class="chip rain" type="button" data-flag="rain" aria-pressed="false">{t("filters.rain")}</button>
      <button class="chip" type="button" data-flag="farm" aria-pressed="false">{t("filters.farm")}</button>
      <button class="chip" type="button" data-flag="free" aria-pressed="false">{t("filters.free")}</button>
      <button class="chip" type="button" data-flag="animals" aria-pressed="false">{t("filters.animals")}</button>
      <button class="chip" type="button" data-flag="changing" aria-pressed="false">{t("filters.changing")}</button>
      {lang !== "de" && <button class="chip" type="button" data-flag="nogerman" aria-pressed="false">{t("filters.nogerman")}</button>}
      <label class="chip">{t("filters.radius")}
        <select id="radius" aria-label={t("filters.radius")}>
          <option value="10">10 km</option><option value="30" selected>30 km</option><option value="60">60 km</option><option value="100">100 km</option>
        </select>
      </label>
    </div>
    <p class="loc-msg small" role="status" data-loc-msg hidden></p>
    {seasons.map((s) => (
      <p class="season-bar small" data-season-bar={s.id} hidden>
        {s.hub && <><a href={s.hub.href} data-season-hub={s.id}>{s.hub.label} →</a><br /></>}
        {s.add} <a href={`/${lang}/mitmachen/#event`}>{t("season.addLink")}</a>
        · <button class="link-btn" type="button" data-season-share={s.id}>{s.share}</button>
      </p>
    ))}
  </section>
  <!-- The town picker: a sheet with a search box, towns A–Z in the reader's language, the current one first.
       A plain <select> can't be searched, and on phones it showed the region file's order. -->
  <dialog class="sheet town-sheet" data-town-sheet aria-label={t("near")} autofocus>
    <form method="dialog">
      <label class="search">
        <span class="sr-only">{t("townPh")}</span>
        <Fragment set:html={svg(UI_ICON.search, 'stroke-width="2"')} />
        <input type="search" data-town-q placeholder={t("townPh")} autocomplete="off" enterkeyhint="go" />
      </label>
      <ul class="town-list" data-town-list>
        {towns.map((h) => (
          <li><button type="submit" value={h.name} data-town={h.name} data-keys={h.keys}>{h.label}</button></li>
        ))}
      </ul>
      <p class="small" data-town-none hidden>{t("townNone")}</p>
    </form>
  </dialog>

  <!-- One row: the shortcuts on the left share it with the map button, so they take no room of their own. -->
  <div class="map-bar">
    <nav class="shortcuts" aria-label={t("shortcuts")} data-shortcuts>
      <a class="shortcut" href={`/${lang}/wochenende/`} data-weekend-link hidden>📰 {t("weekend.nav")}<span class="new" data-weekend-new hidden>{t("weekend.new")}</span></a>
      {seasonLinks.map((s) => <a class="shortcut" href={s.hub} data-season-link={s.id} hidden>{s.label}</a>)}
    </nav>
    <button class="map-btn" type="button" data-map-toggle aria-expanded="false" aria-controls="explore-map">
      <Fragment set:html={svg(UI_ICON.map, 'stroke-width="2"')} /><span class="map-long" data-map-label>{t("mapShow")}</span><span class="map-short" data-map-short>{t("mapShowShort")}</span>
    </button>
  </div>
  <div class="mapwrap explore-map" id="explore-map" hidden>
    <OutingsMap client:only="preact" pinsBase={`/${lang}/pins/`} toiletsUrl="/toilets.json" center={mapCenter(data)} towns={homes.map((x) => [x.name, x.lat, x.lon])} locale={t.locale} labels={mapLabels} />
    <!-- The two marks everyone needs stay in view; the rest fold away behind "More". -->
    <div class="legend">
      <span><i style="background:#ffcc00"></i>{t("legend.event")}</span>
      <span><i style="background:#6f4a2a"></i>{t("legend.place")}</span>
      <span data-here-legend hidden><i class="here-key"></i>{t("legend.here")}</span>
      <details class="legend-more">
        <summary>{t("legend.more")}</summary>
        <div>
          <span><i class="cluster-key">9</i>{t("legend.cluster")}</span>
          <span><i style="border:2px dashed currentColor"></i>{t("legend.approx")}</span>
          <span><i class="area-key"></i>{t("legend.area")}</span>
          <span><i style="border:1px dotted currentColor"></i>{t("legend.radius")}</span>
        </div>
      </details>
    </div>
  </div>

  <p class="area-note" data-area-note hidden>{t("mapAreaOn")} <button type="button" class="link-btn" data-area-reset></button></p>

  {tips.map((e) => (
    <a class="tip" href={pathFor(lang, e)} data-tip={e.id} hidden>
      <Stamp item={e} t={t} />
      <div>
        <div class="kicker" data-tip-kicker></div>
        <h2>{tr(e.title, lang)}</h2>
        <p>{[e.venue, townName(e.town, lang, homes), e.time].filter(Boolean).join(" · ")}<span data-km></span></p>
      </div>
    </a>
  ))}

  <section class="section" aria-labelledby="ideas-h">
    <h2 id="ideas-h" class="ideas-h">{t("ideas")}</h2>
    <div class="ideas-meta">
      <p data-count aria-live="polite"></p>
      <!-- Mixed by default (shuffled once a day per town, lib/order.ts); parents can sort instead. -->
      <label class="order-pick"><span aria-hidden="true">⇅</span>
        <select id="order" aria-label={t("order.label")}>
          {["mixed", "soonest", "nearest"].map((o) => <option value={o}>{t(`order.${o}`)}</option>)}
        </select>
      </label>
    </div>
    <div class="filters kinds" role="group" aria-label={t("ideasKinds")}>
      <button class="chip" type="button" data-kind-chip="" aria-pressed="true">{t("allKinds")} <span class="n" data-n></span></button>
      <button class="chip" type="button" data-kind-chip="event" aria-pressed="false"><span class="dot-ev" aria-hidden="true"></span> {t("kindEvents")} <span class="n" data-n></span></button>
      {presentKinds.map((k) => (
        <button class="chip" type="button" data-kind-chip={k} aria-pressed="false"><Fragment set:html={svg(KIND_ICON[k])} /> {t(`kinds.${k}`)} <span class="n" data-n></span></button>
      ))}
    </div>
    <div class="filters types" role="group" aria-label={t("eventTypes")} data-types hidden>
      <button class="chip" type="button" data-tag-chip="" aria-pressed="true">{t("allTypes")} <span class="n" data-n></span></button>
      {presentTags.map((g) => <button class="chip" type="button" data-tag-chip={g} aria-pressed="false">{t(`tags.${g}`)} <span class="n" data-n></span></button>)}
    </div>
    <div class="grid ideas" id="ideas">
      <div class="empty" data-empty hidden>{t("noIdeas")}</div>
      <div class="empty" data-empty-town hidden></div>
    </div>
    <!-- Every card waits here, outside the page, until the filters show it: a few thousand cards
         in the live page made phones slow to open and to switch back to. They arrive a tile at a time from
         /<lang>/ideen/<tile>/ (pages/[lang]/ideen/[tile].astro, lib/tiles.ts) right after the page shows,
         only for the tiles around home, so the page itself stays small. -->
    <template id="ideas-pool" data-src={`/${lang}/ideen/`}></template>
    <p class="small ideas-loading" data-loading>{t("loading")}</p>
    <button class="more-btn" type="button" data-more hidden></button>
  </section>
  {events.length + places.length === 0 && <p class="empty">{t("empty")}</p>}
  <!-- What the site is, in words a search engine can read: the cards arrive by script, so without this
       the page says little about itself (and nothing that answers a search for 小出游). -->
  <section class="brand-about">
    <h2>{t("brandAbout.h")}</h2>
    <p class="small">{t("brandAbout.p")}</p>
  </section>
  <script is:inline type="application/json" id="explore-ui" set:html={JSON.stringify(pluralUi)} />
  <!-- Codes on the Rednote cards ("K31-2") and the page each opens; typed into the search box (explore.ts). -->
  <script is:inline type="application/json" id="xhs-codes" set:html={JSON.stringify((await rednoteSets()).codes)} />
  <script>
    import "../../scripts/explore";
  </script>
</Base>
