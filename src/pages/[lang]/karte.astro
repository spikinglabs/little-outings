---
import Base from "../../layouts/Base.astro";
import OutingsMap, { type Pin } from "../../islands/OutingsMap";
import Card from "../../components/Card.astro";
import { LANGS, useT, type Lang } from "../../lib/i18n";
import { getData } from "../../lib/data";
import { townName } from "../../lib/format";
import { buildPins, mapCenter, mappable } from "../../lib/pins";

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const data = await getData();
const { region, events, places } = data;
const pins: Pin[] = buildPins(data, lang, t);
const labels = {
  ...(t.group("nEvents") as { one: string; other: string }),
  more: t("mapMore"),
  inView: t.group("mapCount") as { one: string; other: string },
  showMore: t("mapShowMore"),
};
// Every mappable event and place, rendered hidden; the map shows the ones inside its current view.
const listed = [...events.filter(mappable), ...places.filter(mappable)];
---
<Base lang={lang} title={t("mapTitle")} tab="map">
  <h1 class="page-title">{t("mapTitle")}</h1>
  <p class="page-sub">{t("mapSub", { when: t("whenIn.soon"), home: townName(region.center, lang, region.towns) })}</p>
  <div class="mapwrap">
    <OutingsMap client:only="preact" pins={pins} center={mapCenter(data)} towns={region.towns.map((x) => [x.name, x.lat, x.lon])} locale={t.locale} labels={labels} />
    <noscript><p class="empty">{t("mapNoJs")}</p></noscript>
    <div class="legend">
      <span><i style="background:#ffcc00"></i>{t("legend.event")}</span>
      <span><i style="background:#6f4a2a"></i>{t("legend.place")}</span>
      <span><i style="border:2px dashed currentColor"></i>{t("legend.approx")}</span>
      <span><i style="background:rgb(111 74 42 / .12);border:1px dashed #6f4a2a;border-radius:50%"></i>{t("legend.area")}</span>
    </div>
  </div>
  <section class="section map-list" aria-labelledby="ml-h">
    <div class="section-head"><h2 id="ml-h">{t("mapListTitle")}</h2><p data-map-count aria-live="polite"></p></div>
    <div class="grid" id="map-list">{listed.map((x) => <Card item={x} t={t} hidden />)}</div>
    <p class="empty" data-map-empty hidden>{t("mapListEmpty")}</p>
    <button class="more-btn" type="button" data-map-more hidden></button>
  </section>
</Base>
