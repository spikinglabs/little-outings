---
import Base from "../../layouts/Base.astro";
import OutingsMap, { type Pin } from "../../islands/OutingsMap";
import { LANGS, tr, useT, type Lang } from "../../lib/i18n";
import { getData } from "../../lib/data";
import { dateRange, pathFor, townName } from "../../lib/format";

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const { region, events, places } = await getData();
const center = region.towns.find((x) => x.name === region.center) ?? region.towns[0] ?? { lat: 51.16, lon: 10.45 };
const pins: Pin[] = [
  ...places.map((p) => ({ item: p, title: p.name, sub: `${t(`kinds.${p.kind}`)} · ${townName(p.town, lang, region.towns)}` })),
  ...events.map((e) => ({ item: e, title: tr(e.title, lang), sub: `${dateRange(t, e)}${e.time ? ` · ${e.time}` : ""}` })),
]
  .filter(({ item }) => item.geo.precision !== "unknown" && item.geo.lat != null && item.geo.lon != null)
  .map(({ item, title, sub }) => ({
    id: item.id, type: item.type, title, sub, href: pathFor(lang, item),
    lat: item.geo.lat!, lon: item.geo.lon!, precision: item.geo.precision as Pin["precision"],
  }));
---
<Base lang={lang} title={t("mapTitle")} tab="map">
  <h1 class="page-title">{t("mapTitle")}</h1>
  <p class="page-sub">{t("mapSub", { when: t("whenIn.soon"), home: townName(region.center, lang, region.towns) })}</p>
  <div class="mapwrap">
    <OutingsMap client:only="preact" pins={pins} center={[center.lat, center.lon]} towns={region.towns.map((x) => [x.name, x.lat, x.lon])} />
    <noscript><p class="empty">{t("mapNoJs")}</p></noscript>
    <div class="legend">
      <span><i style="background:#ffcc00"></i>{t("legend.event")}</span>
      <span><i style="background:#6f4a2a"></i>{t("legend.place")}</span>
      <span><i style="border:2px dashed currentColor"></i>{t("legend.approx")}</span>
      <span><i style="background:rgb(111 74 42 / .25)"></i>{t("legend.area")}</span>
    </div>
  </div>
</Base>
