---
// The map lives on Discover now ("Show on map"). Old links to the map page land there with it open.
import { LANGS, type Lang } from "../../lib/i18n";

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const to = `/${lang}/#map`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={to} />
    <script is:inline define:vars={{ to }}>location.replace(to);</script>
  </head>
  <body><a href={to}>{to}</a></body>
</html>
