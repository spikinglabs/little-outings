---
import Base from "../../../layouts/Base.astro";
import { placeKey } from "../../../lib/og";
import Card from "../../../components/Card.astro";
import Stamp from "../../../components/Stamp.astro";
import FacChip from "../../../components/FacChip.astro";
import NearBox from "../../../components/NearBox.astro";
import GapBox from "../../../components/GapBox.astro";
import ReportBox from "../../../components/ReportBox.astro";
import VisitBox from "../../../components/VisitBox.astro";
import ShareButton from "../../../components/ShareButton.astro";
import { shareCard } from "../../../lib/share-card";
import { pageCodes } from "../../../lib/item-codes";
import AskSheet from "../../../components/AskSheet.astro";
import { LANGS, isFallback, tr, useT, type Lang } from "../../../lib/i18n";
import { eventsAt, getData } from "../../../lib/data";
import { ageText, areaName, germanName, latinRuns, nameOf, parentInput, townName } from "../../../lib/format";
import { FEATURES } from "../../../content.config";
import { mapLink } from "../../../lib/maps";
import { UI_ICON, svg } from "../../../lib/icons";
import { askOnPage } from "../../../lib/features";
import type { Place } from "../../../lib/types";
import { placeLd } from "../../../lib/seo";

export async function getStaticPaths() {
  const { places } = await getData();
  return LANGS.flatMap((lang) => places.map((p) => ({ params: { lang, id: p.id }, props: { place: p } })));
}
const { place: p } = Astro.props as { place: Place };
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const { region, events } = await getData();
const town = townName(p.town, lang, region.towns);
const area = areaName(p, lang, region.towns);
// Street address when there is one; otherwise the nearest road ("near …") and the district.
const address = p.street
  ? [p.street, [p.postcode, town].filter(Boolean).join(" ")].join(", ")
  : [p.near && t("nearStreet", { street: p.near }), p.district, [p.postcode, town].filter(Boolean).join(" ")].filter(Boolean).join(", ");
const upcoming = eventsAt(events, p.id);
// Known facilities first (yes, then no), unknown last: "?" means nobody has told us yet.
const order = { yes: 0, no: 1, unknown: 2 } as const;
// "Parents say": what families who went tapped most (at least twice), top three.
const goodFor = Object.entries(p.visits?.good_for ?? {}).filter(([, n]) => (n ?? 0) >= 2)
  .sort((a, b) => (b[1] ?? 0) - (a[1] ?? 0)).slice(0, 3)
  .map(([g]) => (lang === "en" ? t(`goodFor.${g}`).toLowerCase() : t(`goodFor.${g}`)));
// Unknown ones only where they fit the kind: a playground asks about the sandpit, a café about high chairs.
const ask = askOnPage(p.kind);
const rank = (f: string) => (ask.includes(f) ? ask.indexOf(f) : ask.length);
const facs = FEATURES.map((f) => ({ f, ...(p.facilities[f] ?? { status: "unknown" as const, confirmed: 0 }) }))
  .filter((x) => x.status !== "unknown" || ask.includes(x.f))
  .sort((a, b) => order[a.status] - order[b.status] || rank(a.f) - rank(b.f));
// Known first, on top; the "?" ones fold away below the buttons.
const known = facs.filter((x) => x.status !== "unknown");
const unknown = facs.filter((x) => x.status === "unknown");
const map = mapLink(p);
// Search snippet: what it is, where, and what parents can count on there (changing table, sandpit …).
const has = facs.filter((x) => x.status === "yes").map((x) => t(`features.${x.f}`));
const description = [
  [t(`kinds.${p.kind}`), address || area].filter(Boolean).join(" · "),
  has.join(", "),
  p.note && tr(p.note, lang),
].filter(Boolean).join(". ").slice(0, 300);
// The "share as picture" card (src/lib/share-card.ts): what it is, where, and what parents can count on there.
const card = shareCard(lang, {
  tone: "paper", tag: t(`kinds.${p.kind}`), title: nameOf(p, lang), german: germanName(p, lang),
  lines: [address || area, has.slice(0, 5).join(" · "), goodFor.length > 0 && t("visit.parentsSay", { list: goodFor.join(", ") })],
  note: p.note && tr(p.note, lang),
  code: (await pageCodes()).get(`orte/${p.id}/`),
}, t);
const site = Astro.site?.toString().replace(/\/$/, "") ?? "";
const ld = placeLd(p, { url: `${site}${Astro.url.pathname}`, name: nameOf(p, lang), description, lang, facility: (f) => t(`features.${f}`) });
---
<Base lang={lang} title={nameOf(p, lang)} description={description} ld={ld} og={placeKey(p)}>
  <article class="detail" data-lat={p.geo.lat} data-lon={p.geo.lon} data-precision={p.geo.precision}>
    <a class="back" href={`/${lang}/`} data-history>← {t("back")}</a>
    <div class="lead">
      <Stamp item={p} t={t} />
      <div>
        <h1>{latinRuns(nameOf(p, lang), lang).map((r) => (r.de ? <span lang="de">{r.s}</span> : r.s))}</h1>
        {germanName(p, lang) && <p class="orig"><span lang="de">{p.name}</span> · {t("machine")}</p>}
        <p class="orig">{t(`kinds.${p.kind}`)} · {area}<span data-km></span>{p.rating && ` · ★ ${p.rating.stars.toLocaleString(t.locale)}`}</p>
      </div>
    </div>
    <ul class="facts">
      <li><span>📍</span><span>{address}
        {p.geo.precision !== "exact" && <><br /><small class="small">{t(`locNote.${p.geo.precision}`, { town })}</small></>}</span></li>
      {p.hours && <li><span>🕘</span><span>{tr(p.hours, lang)}</span></li>}
      {p.ages && <li><span>👧</span><span>{ageText(t, p.ages)}</span></li>}
      {p.indoor != null && <li><span>{p.indoor ? "☂" : "☀"}</span><span>{p.indoor ? t("indoor") : t("outdoor")}</span></li>}
      {p.free != null && <li><span>€</span><span>{p.free ? t("free") : t("paid")}</span></li>}
    </ul>
    {p.note && <p class="note">{tr(p.note, lang)}</p>}
    {isFallback(p.note, lang) && <p class="orig">{t("translated")}</p>}

    {known.length > 0 && (
      <>
        <h2>{t("forFamilies")}</h2>
        <ul class="checks">{known.map((x) => <FacChip id={p.id} t={t} {...x} />)}</ul>
      </>
    )}

    {p.geo.precision === "exact" && <NearBox lat={p.geo.lat} lon={p.geo.lon} t={t} />}

    {p.visits && p.visits.count > 0 && (
      <p class="went">
        <b>{t("visit.count", { n: p.visits.count })}</b>{p.visits.again > 0 && <> · {t("visit.againCount", { n: p.visits.again })}</>}
        {goodFor.length > 0 && <><br />{t("visit.parentsSay", { list: goodFor.join(", ") })}</>}
      </p>
    )}

    {p.rating && (
      <>
        <h2>{t("parentsSay", { r: p.rating.stars.toLocaleString(t.locale), n: p.rating.reviews })}</h2>
        {p.quotes.map((q) => <blockquote class="quote">{tr(q.text, lang)}<small>{tr(q.who, lang)}</small></blockquote>)}
      </>
    )}

    <div class="actions">
      {map && <a class="btn primary" href={map.google} data-apple-maps={map.apple} data-count="maps" target="_blank" rel="noopener"><Fragment set:html={svg(UI_ICON.map, 'stroke-width="2" width="18" height="18"')} />{t("openMaps")}</a>}
      <button class="btn icon" type="button" title={t("save")} data-save={p.id} aria-pressed="false"><Fragment set:html={svg(UI_ICON.saved, 'stroke-width="2" width="18" height="18"')} /><span class="sr-only" data-save-label>{t("save")}</span></button>
      <ShareButton t={t} title={nameOf(p, lang)} lines={[t(`kinds.${p.kind}`), address]} card={card} lang={lang} town={town} name={p.id} />
      {p.website && !p.website.startsWith("https://www.openstreetmap.org/") && <a class="btn" href={p.website} data-count="website" target="_blank" rel="noopener">{t("website")} ↗</a>}
    </div>

    {/* What nobody has told us yet sits below the buttons, folded into one line with a count. */}
    {unknown.length > 0 && (
      <details class="unknowns">
        <summary>{t(known.length > 0 ? "unknownMore" : "unknownAll", { n: unknown.length })}</summary>
        <ul class="checks">{unknown.map((x) => <FacChip id={p.id} t={t} {...x} />)}</ul>
        <p class="small">{t("unknownNote")}</p>
      </details>
    )}

    {((!p.rating && p.quotes.length > 0) || (p.tips?.length ?? 0) > 0) && (
      <>
        <h2>{t("visit.tipTitle")}</h2>
        {!p.rating && p.quotes.map((q) => <blockquote class="quote">{tr(q.text, lang)}<small>{tr(q.who, lang)}</small></blockquote>)}
        {p.tips?.map((x) => <blockquote class="quote">{x.text}<small>{t(`tipTopic.${x.topic}`).replace(/…$/, "")}{x.by && ` · ${x.by}`}</small></blockquote>)}
      </>
    )}

    {(p.trust.source || p.by) && (
      <p class="small">
        {p.trust.source ? t("trust.base", { source: tr(p.trust.source, lang) }) : t("addedBy", { by: p.by ?? "" })}{parentInput(p) > 0 && ` · ${t("trust.parents", { n: parentInput(p) })}`}
        {" · "}<a href={`/${lang}/daten`}>{t("about.link")}</a>
      </p>
    )}

    {upcoming.length > 0 && (
      <section class="section">
        <div class="section-head"><h2>{t("upcomingHere")}</h2></div>
        <div class="grid">{upcoming.map((e) => <Card item={e} t={t} />)}</div>
      </section>
    )}

    <GapBox item={p} t={t} skipFacilities />
    <AskSheet name={p.name} t={t} />
    <VisitBox item={p} t={t} />
    <ReportBox item={p} t={t} />
  </article>
</Base>
