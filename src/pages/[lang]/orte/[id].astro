---
import Base from "../../../layouts/Base.astro";
import Card from "../../../components/Card.astro";
import Stamp from "../../../components/Stamp.astro";
import GapBox from "../../../components/GapBox.astro";
import ReportBox from "../../../components/ReportBox.astro";
import VisitBox from "../../../components/VisitBox.astro";
import AskSheet from "../../../components/AskSheet.astro";
import { LANGS, isFallback, tr, useT, type Lang } from "../../../lib/i18n";
import { eventsAt, getData } from "../../../lib/data";
import { ageText, germanName, nameOf, parentInput, townName } from "../../../lib/format";
import { FEATURES } from "../../../content.config";
import { mapLink } from "../../../lib/maps";
import { FEATURE_ICON, UI_ICON, svg } from "../../../lib/icons";
import type { Place } from "../../../lib/types";

export async function getStaticPaths() {
  const { places } = await getData();
  return LANGS.flatMap((lang) => places.map((p) => ({ params: { lang, id: p.id }, props: { place: p } })));
}
const { place: p } = Astro.props as { place: Place };
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const { region, events } = await getData();
const town = townName(p.town, lang, region.towns);
const upcoming = eventsAt(events, p.id);
// Known facilities first (yes, then no), unknown last: "?" means nobody has told us yet.
const order = { yes: 0, no: 1, unknown: 2 } as const;
// "Parents say": what families who went tapped most (at least twice), top three.
const goodFor = Object.entries(p.visits?.good_for ?? {}).filter(([, n]) => (n ?? 0) >= 2)
  .sort((a, b) => (b[1] ?? 0) - (a[1] ?? 0)).slice(0, 3)
  .map(([g]) => (lang === "en" ? t(`goodFor.${g}`).toLowerCase() : t(`goodFor.${g}`)));
const facs = FEATURES.map((f) => ({ f, ...(p.facilities[f] ?? { status: "unknown" as const, confirmed: 0 }) }))
  .filter((x) => x.status !== "unknown" || ["playground", "changing_table", "highchairs", "kids_menu", "toys", "animals", "stroller_friendly"].includes(x.f))
  .sort((a, b) => order[a.status] - order[b.status]);
const map = mapLink(p);
---
<Base lang={lang} title={nameOf(p, lang)} description={[t(`kinds.${p.kind}`), town].join(" · ")}>
  <article class="detail" data-lat={p.geo.lat} data-lon={p.geo.lon} data-precision={p.geo.precision}>
    <a class="back" href={`/${lang}/`}>← {t("back")}</a>
    <div class="lead">
      <Stamp item={p} t={t} />
      <div>
        <h1>{nameOf(p, lang)}</h1>
        {germanName(p, lang) && <p class="orig"><span lang="de">{p.name}</span> · {t("machine")}</p>}
        <p class="orig">{t(`kinds.${p.kind}`)} · {town}<span data-km></span>{p.rating && ` · ★ ${p.rating.stars.toLocaleString(t.locale)}`}</p>
      </div>
    </div>
    <ul class="facts">
      <li><span>📍</span><span>{[p.street, [p.postcode, town].filter(Boolean).join(" ")].filter(Boolean).join(", ")}
        {p.geo.precision !== "exact" && <><br /><small class="small">{t(`locNote.${p.geo.precision}`, { town })}</small></>}</span></li>
      {p.hours && <li><span>🕘</span><span>{tr(p.hours, lang)}</span></li>}
      {p.ages && <li><span>👧</span><span>{ageText(t, p.ages)}</span></li>}
      {p.indoor != null && <li><span>{p.indoor ? "☂" : "☀"}</span><span>{p.indoor ? t("indoor") : t("outdoor")}</span></li>}
      {p.free != null && <li><span>€</span><span>{p.free ? t("free") : t("paid")}</span></li>}
    </ul>
    {p.note && <p class="note">{tr(p.note, lang)}</p>}
    {isFallback(p.note, lang) && <p class="orig">{t("translated")}</p>}

    <h2>{t("forFamilies")}</h2>
    <ul class="checks">
      {facs.map(({ f, status, confirmed, votes, byVotes }) => {
        // Tapping a chip asks one quick question: "Is there …?" while parents decide, "Still right?" for sourced facts.
        const open = status === "unknown" || byVotes; // votes may still move it (live in app.ts)
        const sub = votes && votes.yes + votes.no > 0 ? t("chipAsk.votes", { y: votes.yes, n: votes.no })
          : status === "yes" && confirmed > 0 ? t("confirmedBy", { n: confirmed }) : "";
        const name = t(`features.${f}`);
        return (
          <li class={status}>
            <button type="button" data-ask={`${p.id}:fac:${f}`} data-unknown={status === "unknown" ? "" : undefined}
              data-open={open ? "" : undefined} data-icon={open ? svg(FEATURE_ICON[f]) : undefined}
              data-q={open ? t(`chipAsk.q.${f}`) : t("chipAsk.still", { f: name })}>
              <span class="dot" set:html={status === "unknown" ? "?" : svg(FEATURE_ICON[f])} />
              <span>{name}<small data-ask-sub>{sub}</small></span>
            </button>
          </li>
        );
      })}
    </ul>
    <p class="small">{t("unknownNote")}</p>

    {p.visits && p.visits.count > 0 && (
      <p class="went">
        <b>{t("visit.count", { n: p.visits.count })}</b>{p.visits.again > 0 && <> · {t("visit.againCount", { n: p.visits.again })}</>}
        {goodFor.length > 0 && <><br />{t("visit.parentsSay", { list: goodFor.join(", ") })}</>}
      </p>
    )}

    {p.rating && (
      <>
        <h2>{t("parentsSay", { r: p.rating.stars.toLocaleString(t.locale), n: p.rating.reviews })}</h2>
        {p.quotes.map((q) => <blockquote class="quote">{tr(q.text, lang)}<small>{tr(q.who, lang)}</small></blockquote>)}
      </>
    )}

    <div class="actions">
      {map && <a class="btn primary" href={map.google} data-apple-maps={map.apple} target="_blank" rel="noopener">{t("openMaps")}</a>}
      <button class="btn" type="button" data-save={p.id} aria-pressed="false"><Fragment set:html={svg(UI_ICON.saved, 'stroke-width="2" width="18" height="18"')} />{t("save")}</button>
      {p.website && !p.website.startsWith("https://www.openstreetmap.org/") && <a class="btn" href={p.website} target="_blank" rel="noopener">{t("website")} ↗</a>}
    </div>

    {((!p.rating && p.quotes.length > 0) || (p.tips?.length ?? 0) > 0) && (
      <>
        <h2>{t("visit.tipTitle")}</h2>
        {!p.rating && p.quotes.map((q) => <blockquote class="quote">{tr(q.text, lang)}<small>{tr(q.who, lang)}</small></blockquote>)}
        {p.tips?.map((x) => <blockquote class="quote">{x.text}<small>{t(`tipTopic.${x.topic}`).replace(/…$/, "")}</small></blockquote>)}
      </>
    )}

    {p.trust.source && (
      <p class="small">
        {t("trust.base", { source: tr(p.trust.source, lang) })}{parentInput(p) > 0 && ` · ${t("trust.parents", { n: parentInput(p) })}`}
        {" · "}<a href={`/${lang}/daten`}>{t("about.link")}</a>
      </p>
    )}

    {upcoming.length > 0 && (
      <section class="section">
        <div class="section-head"><h2>{t("upcomingHere")}</h2></div>
        <div class="grid">{upcoming.map((e) => <Card item={e} t={t} />)}</div>
      </section>
    )}

    <GapBox item={p} t={t} skipFacilities />
    <AskSheet name={p.name} t={t} />
    <VisitBox item={p} t={t} />
    <ReportBox item={p} t={t} />
  </article>
</Base>
