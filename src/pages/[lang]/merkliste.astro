---
// "Mine": the saved list, what this browser sent us, and a door to the profile (sync, move, download, delete).
// Every saved-list card waits in a <template>; the script moves in the saved ones.
import Base from "../../layouts/Base.astro";
import Card from "../../components/Card.astro";
import SentList from "../../islands/SentList";
import { LANGS, useT, type Lang } from "../../lib/i18n";
import { getData } from "../../lib/data";
import { LIST_KEY } from "../../lib/og";

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const m = (k: string) => t(`mine.${k}`);
const { events, places } = await getData();
---
<Base lang={lang} title={t("savedTitle")} description={t("og.list")} tab="saved" og={LIST_KEY} noindex>
  <h1 class="page-title">{m("title")}</h1>
  <p class="page-sub">{m("sub")}</p>
  <div class="shared" data-shared hidden>
    <p data-shared-text></p>
    <button class="btn primary" type="button" data-shared-add>{t("share.add")}</button>
  </div>

  <section class="section">
    <div class="section-head">
      <h2>{m("saved")}</h2>
      <button class="btn" type="button" data-share data-count="share" hidden>{t("share.button")}</button>
    </div>
    <p class="small share-done" data-share-done role="status" hidden></p>
    <div class="saved-group" data-saved-section>
      <h3>{t("events")}</h3>
      <div class="grid"></div>
      <template>{events.map((e) => <Card item={e} t={t} hidden />)}</template>
    </div>
    <div class="saved-group" data-saved-section>
      <h3>{t("places")}</h3>
      <div class="grid"></div>
      <template>{places.map((p) => <Card item={p} t={t} hidden />)}</template>
    </div>
    <p class="empty" data-saved-empty>{t("savedEmpty")}</p>
  </section>

  <SentList client:only="preact" lang={lang} ui={{ sentTitle: t("mine.sentAdded"), locale: t.locale,
    meetTitle: t("meet.mineTitle"), meetSub: t("meet.mineSub"), meetYours: t("meet.mineYours"), meetOff: t("meet.cancelled"), meetOpen: t("meet.open"),
    meetGoing: t.group("meet.countGoing"), meet_going: t("meet.going"), meet_maybe: t("meet.maybe"), meet_no: t("meet.no"), sentSub: t("profile.sentSub"), sentEdit: t("profile.sentEdit"), sentResend: t("profile.sentResend"),
    status_waiting: t("profile.statusWaiting"), status_changed: t("profile.statusChanged"), status_published: t("profile.statusPublished"),
    status_declined: t("profile.statusDeclined"), seeIt: t("profile.seeIt") }} />

  <section class="section profile-box">
    <h2>{m("profile")}</h2>
    <p class="small" data-sync-line>{m("syncOff")}</p>
    <div class="profile-actions"><a class="btn" href={`/${lang}/profil/`}>{m("syncLink")} →</a></div>
  </section>

  <script is:inline type="application/json" id="share-ui" set:html={JSON.stringify({ shared: t.group("share.shared"), copied: t("share.copied"), title: t("savedTitle"), syncOn: m("syncOn"), syncOff: m("syncOff") })} />
  <script>
    import { saved, markSaved, renderKm, renderSaved } from "../../scripts/app";
    import { getSync, schedulePush } from "../../scripts/sync";
    // Thousands of cards in the live page made phones slow, so only the ones on the list are moved in.
    const pools = [...document.querySelectorAll<HTMLElement>("[data-saved-section]")].map((sec) => ({
      sec,
      grid: sec.querySelector<HTMLElement>(".grid")!,
      cards: [...sec.querySelector("template")!.content.querySelectorAll<HTMLElement>(".item")],
    }));
    function place(ids: Set<string>) {
      let total = 0;
      for (const { sec, grid, cards } of pools) {
        const on = cards.filter((el) => ids.has(el.dataset.id!));
        on.forEach((el) => (el.hidden = false));
        grid.replaceChildren(...on);
        sec.hidden = on.length === 0;
        total += on.length;
      }
      pools.forEach((p) => markSaved(p.grid));
      renderKm();
      return total;
    }
    function show() {
      document.querySelector<HTMLElement>("[data-saved-empty]")!.hidden = place(saved) > 0;
    }
    document.addEventListener("lo:saved", show);
    show();

    // "Share my list": a link that carries the saved ids (?add=a,b,c). Opening it offers to add them,
    // which is also how a list moves to another phone. Nothing is stored anywhere else.
    type Plural = { one?: string; other: string };
    const sui = JSON.parse(document.getElementById("share-ui")!.textContent!) as { shared: Plural; copied: string; title: string; syncOn: string; syncOff: string };
    const syncLine = () => { document.querySelector("[data-sync-line]")!.textContent = getSync() ? sui.syncOn : sui.syncOff; };
    document.addEventListener("lo:sync", syncLine);
    syncLine();
    const known = new Set(pools.flatMap((p) => p.cards.map((el) => el.dataset.id!)));
    const incoming = (new URLSearchParams(location.search).get("add") || "").split(",").filter((id) => known.has(id) && !saved.has(id));
    const box = document.querySelector<HTMLElement>("[data-shared]")!;
    if (incoming.length) {
      const n = incoming.length;
      const p = new Intl.PluralRules(document.body.dataset.lang).select(n) === "one" && sui.shared.one ? sui.shared.one : sui.shared.other;
      box.querySelector("[data-shared-text]")!.textContent = p.replace("{n}", String(n));
      box.hidden = false;
      // Preview what was shared until the reader decides.
      place(new Set([...saved, ...incoming]));
      document.querySelector<HTMLElement>("[data-saved-empty]")!.hidden = true;
    }
    box.querySelector("[data-shared-add]")!.addEventListener("click", () => {
      incoming.forEach((id) => saved.add(id));
      try { localStorage.setItem("lo-saved", JSON.stringify([...saved])); schedulePush(); } catch { /* storage blocked */ }
      box.hidden = true;
      history.replaceState(null, "", location.pathname);
      renderSaved();
    });
    const shareBtn = document.querySelector<HTMLElement>("[data-share]")!;
    const syncBar = () => { shareBtn.hidden = saved.size === 0; };
    document.addEventListener("lo:saved", syncBar);
    syncBar();
    shareBtn.addEventListener("click", async () => {
      const url = `${location.origin}${location.pathname}?add=${[...saved].join(",")}`;
      const done = document.querySelector<HTMLElement>("[data-share-done]")!;
      try {
        if (navigator.share) { await navigator.share({ title: sui.title, url }); return; }
        await navigator.clipboard.writeText(url);
        done.textContent = sui.copied;
      } catch (e) {
        if ((e as Error).name === "AbortError") return; // closed the share sheet
        done.textContent = url;
      }
      done.hidden = false;
    });
  </script>
</Base>
