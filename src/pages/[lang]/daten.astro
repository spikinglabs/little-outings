---
// Where the information comes from and where parents' answers and profiles are kept, in plain words.
// Keep it true: when a data source, the taps store or the profile sync changes, change this page too.
import Base from "../../layouts/Base.astro";
import { LANGS, MAKER_URL, useT, type Lang } from "../../lib/i18n";

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const SECTIONS = ["events", "places", "translate", "taps", "writing", "profile", "location", "none", "wrong", "who"];
---
<Base lang={lang} title={t("about.title")}>
  <h1 class="page-title">{t("about.title")}</h1>
  <p class="page-sub">{t("about.intro")}</p>
  <div class="about">
    {SECTIONS.map((k) => (
      <section>
        <h2>{t(`about.${k}.h`)}</h2>
        <p>{t(`about.${k}.p`)}</p>
        {k === "profile" && <p><a href={`/${lang}/profil/`}>{t("profile.link")} →</a></p>}
        {k === "who" && <p><a href={MAKER_URL} target="_blank" rel="noopener">spikinglabs.com ↗</a></p>}
        {k === "places" && <p class="small"><a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">openstreetmap.org/copyright ↗</a></p>}
      </section>
    ))}
  </div>
</Base>
