---
// A family's profile (under the "Mine" tab; what they sent is listed there): what this browser remembers, with download, load, move to another phone,
// optional passkey sync and delete. No account. See src/lib/profile.ts and functions/api/profile.
import Base from "../../layouts/Base.astro";
import { LANGS, useT, type Lang } from "../../lib/i18n";

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const p = (k: string) => t(`profile.${k}`);
const ui = { ...t.group("profile"), count: t.group("profile.count") };
---
<Base lang={lang} title={p("title")} tab="saved" noindex>
  <a class="back-link" href={`/${lang}/merkliste/`}>← {t("mine.back")}</a>
  <h1 class="page-title">{p("title")}</h1>
  <p class="page-sub">{p("sub")}</p>

  <div class="shared" data-incoming hidden>
    <p data-incoming-text></p>
    <button class="btn primary" type="button" data-incoming-add>{p("incomingAdd")}</button>
  </div>
  <p class="done section" role="status" data-flash hidden></p>

  <section class="section profile-box">
    <h2>{p("have")}</h2>
    <ul class="profile-counts" data-counts></ul>
  </section>

  <section class="section profile-box" id="nick">
    <h2>{p("nickTitle")}</h2>
    <p class="small">{p("nickSub")}</p>
    <form class="profile-actions" data-nick-form>
      <span class="nick-row">
        <input name="by" maxlength="30" autocomplete="off" aria-label={p("nickTitle")} placeholder={p("nickPh")} data-nick-input />
        <button class="btn" type="button" aria-label={t("nick.new")} title={t("nick.new")} data-nick-roll-p>🎲</button>
      </span>
      <button class="btn primary" type="submit">{p("nickSave")}</button>
    </form>
    <p class="small" role="status" data-nick-note hidden>{p("nickSaved")}</p>
  </section>

  <section class="section profile-box">
    <h2>{p("themeTitle")}</h2>
    <p class="small">{p("themeSub")}</p>
    <div class="when" role="group" aria-label={p("themeTitle")} data-theme-pick>
      <button type="button" data-theme-set="auto">{p("themeAuto")}</button>
      <button type="button" data-theme-set="light">{p("themeLight")}</button>
      <button type="button" data-theme-set="dark">{p("themeDark")}</button>
    </div>
  </section>

  <section class="section profile-box" data-passkey>
    <h2>{p("passkeyTitle")}</h2>
    <p class="small">{p("passkeySub")}</p>
    <div class="profile-actions" data-passkey-off>
      <button class="btn primary" type="button" data-passkey-start>{p("passkeyOn")}</button>
    </div>
    <!-- Asked first, so a parent who already has a passkey signs in instead of making a second, empty one. -->
    <div class="profile-ask" data-passkey-ask hidden>
      <p class="done">{p("passkeyAsk")}</p>
      <div class="profile-actions">
        <button class="btn primary" type="button" data-passkey-login>{p("passkeyAskYes")}</button>
        <button class="btn" type="button" data-passkey-on>{p("passkeyAskNo")}</button>
      </div>
    </div>
    <div data-passkey-synced hidden>
      <p class="done">{p("passkeySynced")} <span class="small" data-passkey-last></span></p>
      <div class="profile-actions">
        <button class="btn primary" type="button" data-passkey-now>{p("passkeyNow")}</button>
        <button class="btn" type="button" data-passkey-login>{p("passkeyOther")}</button>
        <button class="btn" type="button" data-passkey-signout>{p("passkeyOff")}</button>
      </div>
      <p class="small">{p("passkeyOtherSub")}</p>
    </div>
    <p class="small" role="status" data-passkey-note hidden></p>
  </section>

  <section class="section profile-box">
    <h2>{p("moveTitle")}</h2>
    <p class="small">{p("moveSub")}</p>
    <div class="profile-actions"><button class="btn" type="button" data-move>{p("moveButton")}</button></div>
    <div class="profile-qr" data-move-out hidden>
      <div class="qr" data-qr></div>
      <button class="btn" type="button" data-move-copy>{p("moveCopy")}</button>
      <p class="small" role="status" data-move-note hidden></p>
    </div>
  </section>

  <section class="section profile-box">
    <h2>{p("fileTitle")}</h2>
    <p class="small">{p("fileSub")}</p>
    <div class="profile-actions">
      <button class="btn" type="button" data-download>{p("download")}</button>
      <button class="btn" type="button" data-load-pick>{p("load")}</button>
      <input type="file" accept="application/json,.json" data-load hidden />
    </div>
  </section>

  <section class="section profile-box">
    <h2>{p("deleteTitle")}</h2>
    <p class="small">{p("deleteSub")}</p>
    <div class="profile-actions" data-delete-start><button class="btn danger" type="button" data-delete-open>{p("delete")}</button></div>
    <!-- Three steps before anything goes: open this, type the word, then confirm once more. -->
    <form class="profile-ask" data-delete-ask hidden>
      <p class="done">{p("deleteWarn")}</p>
      <ul class="profile-counts" data-delete-lose></ul>
      <p class="small">{p("deleteKeep")}</p>
      <div class="profile-actions"><button class="btn" type="button" data-delete-download>{p("deleteDownload")}</button></div>
      <label>{p("deleteType")} <b>{p("deleteSentence")}</b>
        <input name="word" autocomplete="off" spellcheck="false" placeholder={p("deleteSentence")} data-delete-word />
      </label>
      <div class="profile-actions">
        <button class="btn danger" type="submit" disabled data-delete>{p("deleteGo")}</button>
        <button class="btn" type="button" data-delete-cancel>{p("deleteCancel")}</button>
      </div>
    </form>
  </section>

  <script is:inline type="application/json" id="profile-ui" set:html={JSON.stringify(ui)} />
  <script>
    import { browserSupportsWebAuthn } from "@simplewebauthn/browser";
    import { login, register } from "../../scripts/passkey";
    import { renderSVG } from "uqr";
    import { clean, forget, packForMove, readProfile, unpackMove, type Profile } from "../../lib/profile";
    import { adopt, getSync, lastSynced, push, schedulePush, setSync, syncNow } from "../../scripts/sync";
    import { cleanNick, randomNick, rememberNick } from "../../lib/nickname";

    type Plural = Record<string, string>;
    const ui = JSON.parse(document.getElementById("profile-ui")!.textContent!) as Record<string, string> & { count: Record<string, Plural | string> };
    const lang = document.body.dataset.lang!;
    const rules = new Intl.PluralRules(lang);
    const plural = (forms: Plural, n: number) => (forms[rules.select(n)] ?? forms.other).replace("{n}", String(n));
    const $ = <T extends HTMLElement = HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
    const local = () => readProfile(localStorage);

    /* ---------- the nickname contributions are shown under ---------- */
    const nickInput = $<HTMLInputElement>("[data-nick-input]");
    nickInput.value = local().nick ?? "";
    $("[data-nick-roll-p]").addEventListener("click", () => { nickInput.value = randomNick(lang); });
    $("[data-nick-form]").addEventListener("submit", (e) => {
      e.preventDefault();
      try { rememberNick(localStorage, nickInput.value); nickInput.value = cleanNick(nickInput.value); schedulePush(); } catch { /* storage blocked */ }
      $("[data-nick-note]").hidden = false;
    });

    const flash = (text: string) => { const el = $("[data-flash]"); el.textContent = text; el.hidden = false; };

    /* ---------- what's on this phone ---------- */
    function countLines(p: Profile) {
      const c = ui.count;
      return [
        p.saved.length && plural(c.saved as Plural, p.saved.length),
        p.went.length && plural(c.went as Plural, p.went.length),
        Object.keys(p.asked).length && plural(c.asked as Plural, Object.keys(p.asked).length),
        p.sent.length && plural(c.sent as Plural, p.sent.length),
        p.home && (c.home as string).replace("{town}", p.home),
        p.nick && (c.nick as string).replace("{nick}", p.nick),
      ].filter(Boolean) as string[];
    }
    function renderCounts() {
      const lines = countLines(local());
      $("[data-counts]").replaceChildren(...(lines.length ? lines : ["–"]).map((s) => Object.assign(document.createElement("li"), { textContent: s })));
    }
    document.addEventListener("lo:profile", renderCounts);
    renderCounts();

    /* ---------- light or dark ---------- */
    // Kept in this browser only (lo-theme), like a device setting; the head script in Base.astro applies it on load.
    const LIGHT = "#ffcc00", DARK = "#121314";
    function applyTheme(choice: string) {
      const root = document.documentElement;
      const metas = document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]');
      try { choice === "auto" ? localStorage.removeItem("lo-theme") : localStorage.setItem("lo-theme", choice); } catch { /* private mode: this page only */ }
      if (choice === "auto") {
        delete root.dataset.theme;
        metas.forEach((m) => (m.content = m.media.includes("dark") ? DARK : LIGHT));
      } else {
        root.dataset.theme = choice;
        metas.forEach((m) => (m.content = choice === "dark" ? DARK : LIGHT));
      }
      document.querySelectorAll("[data-theme-set]").forEach((b) => b.setAttribute("aria-pressed", String((b as HTMLElement).dataset.themeSet === choice)));
    }
    document.querySelectorAll<HTMLElement>("[data-theme-set]").forEach((b) => b.addEventListener("click", () => applyTheme(b.dataset.themeSet!)));
    applyTheme(document.documentElement.dataset.theme ?? "auto");

    /* ---------- passkey sync ---------- */
    const note = (text: string) => { const el = $("[data-passkey-note]"); el.textContent = text; el.hidden = !text; };
    function renderSync() {
      const s = getSync();
      $("[data-passkey-off]").hidden = !!s;
      $("[data-passkey-ask]").hidden = true;
      $("[data-passkey-synced]").hidden = !s;
      const when = lastSynced(s);
      $("[data-passkey-last]").textContent = s?.dirty ? ui.passkeyPending : when
        ? ui.passkeyLast.replace("{when}", new Intl.DateTimeFormat(lang, { dateStyle: "medium", timeStyle: "short" }).format(when)) : "";
    }
    document.addEventListener("lo:sync", renderSync);
    renderSync();

    // Opening this page syncs right away; the button does it again on demand.
    const now = $<HTMLButtonElement>("[data-passkey-now]");
    async function runSync(byHand: boolean) {
      if (!getSync() || now.disabled) return;
      now.disabled = true;
      now.textContent = ui.passkeyNowBusy;
      const ok = await syncNow();
      now.disabled = false;
      now.textContent = ui.passkeyNow;
      if (byHand || !ok) note(ok ? "" : getSync() ? ui.passkeyNowFailed : "");
    }
    now.addEventListener("click", () => runSync(true));
    runSync(false);
    if (!browserSupportsWebAuthn()) { $("[data-passkey-off]").hidden = true; note(ui.passkeyNone); }

    $("[data-passkey-start]").addEventListener("click", () => {
      note("");
      $("[data-passkey-off]").hidden = true;
      $("[data-passkey-ask]").hidden = false;
    });

    const said: Record<string, string> = { soon: ui.passkeySoon, fail: ui.passkeyFailed, unknown: ui.passkeyUnknown };
    $("[data-passkey-on]").addEventListener("click", async () => {
      note("");
      const r = await register();
      if (said[r]) note(said[r]);
    });

    // Signing in merges the passkey's copy into this phone's profile, so it also works while synced
    // with another passkey: nothing on this phone is dropped.
    document.querySelectorAll("[data-passkey-login]").forEach((b) => b.addEventListener("click", async () => {
      note("");
      const r = await login();
      if (r === "ok") flash(ui.passkeyWelcome);
      else if (said[r]) note(said[r]);
    }));

    $("[data-passkey-signout]").addEventListener("click", async () => {
      const s = getSync();
      await push(); // the latest changes first
      if (s) fetch("/api/profile/logout", { method: "POST", headers: { authorization: `Bearer ${s.token}` } }).catch(() => {});
      setSync(null);
    });

    /* ---------- move to another phone ---------- */
    let moveUrl = "";
    $("[data-move]").addEventListener("click", async () => {
      const { code, full } = await packForMove(local());
      moveUrl = `${location.origin}${location.pathname}#p=${code}`;
      $("[data-qr]").innerHTML = renderSVG(moveUrl, { border: 2, pixelSize: 4 });
      const n = $("[data-move-note]");
      n.textContent = full ? "" : ui.movePartial;
      n.hidden = full;
      $("[data-move-out]").hidden = false;
    });
    $("[data-move-copy]").addEventListener("click", async () => {
      const n = $("[data-move-note]");
      try { await navigator.clipboard.writeText(moveUrl); n.textContent = ui.moveCopied; } catch { n.textContent = moveUrl; }
      n.hidden = false;
    });

    const code = new URLSearchParams(location.hash.slice(1)).get("p");
    if (code) {
      const box = $("[data-incoming]");
      unpackMove(code).then((incoming) => {
        if (!incoming) { history.replaceState(null, "", location.pathname); return flash(ui.incomingBad); }
        $("[data-incoming-text]").textContent = plural(ui.incoming as unknown as Plural, incoming.saved.length);
        box.hidden = false;
        $("[data-incoming-add]").addEventListener("click", () => {
          adopt(incoming);
          box.hidden = true;
          history.replaceState(null, "", location.pathname);
          flash(ui.incomingDone);
        });
      });
    }

    /* ---------- download and load ---------- */
    $("[data-download]").addEventListener("click", async () => {
      const p = local();
      // The quick votes live on our side, counted under this browser's random id: fetch them too.
      let votes: unknown = [];
      if (p.voter) {
        try {
          const res = await fetch("/api/taps?mine=1", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ voter: p.voter }) });
          if (res.ok) votes = await res.json();
        } catch { /* offline: the profile alone */ }
      }
      const file = { ...p, exported: new Date().toISOString(), site: location.origin, synced_with_passkey: !!getSync(), votes };
      const a = Object.assign(document.createElement("a"), {
        href: URL.createObjectURL(new Blob([JSON.stringify(file, null, 2)], { type: "application/json" })),
        download: `little-outings-${new Date().toISOString().slice(0, 10)}.json`,
      });
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 10_000);
    });

    $("[data-load-pick]").addEventListener("click", () => $("[data-load]").click());
    $<HTMLInputElement>("[data-load]").addEventListener("change", async (ev) => {
      const input = ev.target as HTMLInputElement;
      const f = input.files?.[0];
      input.value = "";
      if (!f) return;
      try {
        const data = JSON.parse(await f.text());
        if (data?.app !== "little-outings") throw new Error("not ours");
        adopt(clean(data));
        flash(ui.loaded);
      } catch { flash(ui.loadBad); }
    });

    /* ---------- delete ---------- */
    const ask = $<HTMLFormElement>("[data-delete-ask]");
    const word = $<HTMLInputElement>("[data-delete-word]");
    // The whole sentence, typed out; case, spaces and a final full stop don't matter.
    const norm = (v: string) => v.toLocaleLowerCase(lang).replace(/[\s.。!！]+/g, " ").trim();
    const typed = () => norm(word.value) === norm(ui.deleteSentence);
    $("[data-delete-open]").addEventListener("click", () => {
      // What exactly goes, from what this phone holds now.
      const lose = [...countLines(local()), ...(getSync() ? [ui.deletePasskey] : []), ui.deleteVotes];
      $("[data-delete-lose]").replaceChildren(...lose.map((s) => Object.assign(document.createElement("li"), { textContent: s })));
      ask.hidden = false; $("[data-delete-start]").hidden = true; word.focus();
    });
    $("[data-delete-download]").addEventListener("click", () => $("[data-download]").click());
    $("[data-delete-cancel]").addEventListener("click", () => { ask.hidden = true; $("[data-delete-start]").hidden = false; word.value = ""; $<HTMLButtonElement>("[data-delete]").disabled = true; });
    word.addEventListener("input", () => { $<HTMLButtonElement>("[data-delete]").disabled = !typed(); });
    ask.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!typed() || !confirm(ui.deleteConfirm)) return;
      const p: Profile = local();
      const s = getSync();
      // Our side first. If that fails, the phone keeps its ids so the parent can simply try again.
      // 503: that store isn't set up, so it holds nothing. 401: the passkey copy is already gone.
      const gone = (r: Response) => r.ok || r.status === 503 || r.status === 404 || r.status === 401;
      try {
        if (p.voter && !gone(await fetch("/api/taps", { method: "DELETE", headers: { "content-type": "application/json" }, body: JSON.stringify({ voter: p.voter }) }))) throw new Error();
        if (s && !gone(await fetch("/api/profile/data", { method: "DELETE", headers: { authorization: `Bearer ${s.token}` } }))) throw new Error();
      } catch { return flash(ui.passkeyFailed); }
      forget(localStorage);
      document.dispatchEvent(new CustomEvent("lo:profile"));
      document.dispatchEvent(new CustomEvent("lo:sync"));
      flash(ui.deleted);
      $<HTMLButtonElement>("[data-delete-cancel]").click();
      nickInput.value = "";
    });
  </script>
</Base>
