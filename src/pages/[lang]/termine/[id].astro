---
import Base from "../../../layouts/Base.astro";
import Stamp from "../../../components/Stamp.astro";
import GapBox from "../../../components/GapBox.astro";
import ReportBox from "../../../components/ReportBox.astro";
import VisitBox from "../../../components/VisitBox.astro";
import { LANGS, isFallback, tr, useT, type Lang } from "../../../lib/i18n";
import { getData, getWeather, TODAY } from "../../../lib/data";
import { dayAt, skyIcon, skyWord } from "../../../lib/weather";
import { runsLong } from "../../../lib/running";
import { ageText, dateRange, germanName, latinRuns, nameOf, pathFor, townName } from "../../../lib/format";
import { mapLink } from "../../../lib/maps";
import { FEATURE_ICON, UI_ICON, svg } from "../../../lib/icons";
import type { Event } from "../../../lib/types";
import { LANGUAGE } from "../../../content.config";
import { calInput } from "../../../lib/event-cal";
import { googleUrl, ics } from "../../../lib/calendar";
import { eventLd } from "../../../lib/seo";
import { seasonPageFor, seasonPath } from "../../../lib/seasons";
import { eventKey } from "../../../lib/og";
import ShareButton from "../../../components/ShareButton.astro";
import { shareCard } from "../../../lib/share-card";
import { pageCodes } from "../../../lib/item-codes";

export async function getStaticPaths() {
  const { events } = await getData();
  return LANGS.flatMap((lang) => events.map((e) => ({ params: { lang, id: e.id }, props: { event: e } })));
}
const { event: e } = Astro.props as { event: Event };
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const { region, placeById, seasons } = await getData();
const place = e.place ? placeById.get(e.place) : undefined;
const title = nameOf(e, lang);
const german = germanName(e, lang);
const town = townName(e.town, lang, region.towns);
const prec = e.geo.precision;
const yes = Object.entries(place?.facilities ?? {}).filter(([, v]) => v.status === "yes").map(([k]) => k);
const cal = await calInput(e, lang, Astro.site);
// The calendar file's text, served as /api/ics/<lang>/<id>.ics (functions/api/ics). The build day, not
// the second: an unchanged event gives the same page, so a deploy skips uploading it.
const icsText = ics(cal, `${new Date().toISOString().slice(0, 10).replace(/-/g, "")}T000000Z`).replace(/<\//g, "<\\/");
const translated = isFallback(e.title, lang) || isFallback(e.note, lang);
const map = mapLink(e, place);
// The forecast for the event's day when it's within the next week (built nightly). Exhibitions and other long runs have no one day.
const wx = runsLong(e.start, e.end) ? undefined : dayAt(await getWeather(), e.town, e.start < TODAY ? TODAY : e.start);
// A season's note (St. Martin walks are often for one Kita only, so ask first) and its town page.
const seasonNotes = seasons.seasons.filter((s) => s.note && e.seasons?.includes(s.id));
const seasonPage = seasonPageFor(e, seasons);
// Search snippet: when, where, what kind and the organiser's note, so the result answers "what is it?".
const where = [place ? nameOf(place, lang) : e.venue, town].filter(Boolean).join(", ");
const description = [
  [dateRange(t, e), e.time, where].filter(Boolean).join(" · "),
  [e.price?.free && t("free"), ...e.tags.filter((g) => g !== "other").map((g) => t(`tags.${g}`))].filter(Boolean).join(", "),
  e.note && tr(e.note, lang),
].filter(Boolean).join(". ").slice(0, 300);
// The "share as picture" card (src/lib/share-card.ts).
const card = shareCard(lang, {
  tone: "gold", tag: [dateRange(t, e), e.time].filter(Boolean).join(" · "), title, german,
  lines: [where, e.price && (e.price.free ? t("free") : tr(e.price.text, lang) || t("paid")), e.ages && ageText(t, e.ages), e.indoor != null && (e.indoor ? t("indoor") : t("outdoor"))],
  note: e.note && tr(e.note, lang),
  code: (await pageCodes()).get(`termine/${e.id}/`),
}, t);
const site = Astro.site?.toString().replace(/\/$/, "") ?? "";
const ld = eventLd(e, {
  url: `${site}${Astro.url.pathname}`, name: title, description, lang, place,
  placeUrl: place && `${site}${pathFor(lang, place)}`, placeName: place && nameOf(place, lang),
});
---
<Base lang={lang} title={title} description={description} ld={ld} og={eventKey(e)}>
  <article class="detail" data-lat={e.geo.lat} data-lon={e.geo.lon} data-precision={prec}>
    <a class="back" href={`/${lang}/`}>← {t("back")}</a>
    <div class="lead">
      <Stamp item={e} t={t} />
      <div>
        <h1>{latinRuns(title, lang).map((r) => (r.de ? <span lang="de">{r.s}</span> : r.s))}</h1>
        {isFallback(e.title, lang) && <p class="orig">{t("translated")}</p>}
        {german && <p class="orig"><span lang="de">{german}</span> · {t("machine")}</p>}
      </div>
    </div>
    <ul class="facts">
      <li><span>📅</span><span>{dateRange(t, e)}{e.time && ` · ${e.time}`}</span></li>
      <li><span>📍</span><span>
        {place ? <a href={pathFor(lang, place)}>{nameOf(place, lang)}</a> : [e.venue, e.address].filter(Boolean).join(", ")}{(place || e.venue || e.address) && town && ", "}{town}<span data-km></span>
        {e.address && !place && <><br /><small class="small">{t("whereByParents")}</small></>}
        {prec !== "exact" && !e.address && <><br /><small class="small">{t(`locNote.${prec === "area" && e.venue ? "venue" : prec}`, { town })}</small></>}
      </span></li>
      {e.price && <li><span>€</span><span>{e.price.free ? t("free") : tr(e.price.text, lang) || t("paid")}</span></li>}
      {e.ages && <li><span>👧</span><span>{ageText(t, e.ages)}</span></li>}
      {wx && <li><span>{skyIcon(wx.code)}</span><span>{t("wx.forecast")}: {skyWord(wx.code, lang)}, {wx.max}° / {wx.min}°{wx.rain >= 30 && ` · ${t("wx.rainChance", { n: wx.rain })}`}
        {" "}<a class="small" href="https://open-meteo.com/" target="_blank" rel="noopener">Open-Meteo</a></span></li>}
      {e.indoor != null && <li><span>{e.indoor ? "☂" : "☀"}</span><span>{e.indoor ? t("indoor") : t("outdoor")}</span></li>}
      <li><span>✓</span><span class="small">
        {e.trust.level === "community" ? (e.by ? t("trust.byNick", { by: e.by }) : t("trust.community")) : <>{t(`trust.${e.trust.level}`)}{e.trust.source && ` · ${tr(e.trust.source, lang)}`}</>}
      </span></li>
    </ul>

    {/* How much German it needs: a guess from the title until parents tap one of the chips. */}
    <section class="speech-ask" data-lang-ask={e.id} data-votes={JSON.stringify(e.languageVotes ?? {})}>
      <h2>💬 {t("speechAsk.title")}</h2>
      <div class="speech-chips">
        {LANGUAGE.map((k) => (
          <button type="button" class:list={["chip", { current: e.language === k, guess: e.languageFrom === "guess" }]} data-lang-answer={k} aria-pressed="false">
            {t(`speech.${k}`)}<small data-n>{e.languageVotes?.[k] ? ` · ${e.languageVotes[k]}` : ""}</small>
          </button>
        ))}
      </div>
      <p class="small" data-lang-note>{
        e.languageFrom === "parents" ? t("speechAsk.parents", { n: Object.values(e.languageVotes ?? {}).reduce((a, b) => a + (b ?? 0), 0) })
        : e.languageFrom === "guess" ? t("speechAsk.guess")
        : !e.language ? t("speechAsk.unknown") : ""
      }</p>
    </section>
    {seasonNotes.map((s) => <p class="note season-note">{s.emoji} {tr(s.note, lang)}</p>)}
    {e.note && <p class="note">{tr(e.note, lang)}</p>}
    {e.kids && <p class="note">{t("kids.label")}: {e.kids.map((k) => t(`kids.${k}`)).join(", ")}</p>}
    {seasonPage && <p class="note"><a href={seasonPath(lang, seasonPage.season, seasonPage.file.slug)}>{seasonPage.season.emoji} {tr(seasonPage.season.page!.title, lang).replace("{town}", town)} →</a></p>}
    {translated && lang !== "de" && !isFallback(e.title, lang) && <p class="orig">{t("translated")}</p>}

    {place && yes.length > 0 && (
      <>
        <h2>{t("forFamilies")}</h2>
        <ul class="checks">
          {yes.map((f) => <li><span class="dot" set:html={svg(FEATURE_ICON[f])} /><span>{t(`features.${f}`)}</span></li>)}
        </ul>
      </>
    )}

    <div class="actions">
      {map && <a class="btn primary" href={map.google} data-apple-maps={map.apple} data-count="maps" target="_blank" rel="noopener"><Fragment set:html={svg(UI_ICON.map, 'stroke-width="2" width="18" height="18"')} />{t("openMaps")}</a>}
      <button class="btn icon" type="button" title={t("save")} data-save={e.id} aria-pressed="false"><Fragment set:html={svg(UI_ICON.saved, 'stroke-width="2" width="18" height="18"')} /><span class="sr-only" data-save-label>{t("save")}</span></button>
      <ShareButton t={t} title={title} lines={[[dateRange(t, e), e.time].filter(Boolean).join(" · "), where]} card={card} lang={lang} town={town} name={e.id} />
      <details class="cal-menu">
        <summary class="btn icon" title={t("cal.add")}><Fragment set:html={svg(UI_ICON.calendar, 'stroke-width="2" width="18" height="18"')} /><span class="sr-only">{t("cal.add")}</span></summary>
        <div class="cal-opts">
          <a href={googleUrl(cal)} data-count="calendar" target="_blank" rel="noopener">{t("cal.google")} ↗</a>
          <a href={`/api/ics/${lang}/${e.id}.ics`} download={`${e.id}.ics`} data-count="calendar">{t("cal.ics")}</a>
          <script is:inline type="text/calendar" id="ics" set:html={icsText} />
        </div>
      </details>
      {e.website && <a class="btn" href={e.website} data-count="website" target="_blank" rel="noopener">{t("website")} ↗</a>}
    </div>
    {e.origin && <p class="small">{t("source")}: <a href={e.origin.url} target="_blank" rel="noopener">{e.origin.name}</a></p>}

    <GapBox item={e} t={t} />
    <VisitBox item={e} t={t} />
    <ReportBox item={e} t={t} />
  </article>
</Base>
