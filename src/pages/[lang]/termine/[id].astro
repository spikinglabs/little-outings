---
import Base from "../../../layouts/Base.astro";
import Stamp from "../../../components/Stamp.astro";
import GapBox from "../../../components/GapBox.astro";
import ReportBox from "../../../components/ReportBox.astro";
import VisitBox from "../../../components/VisitBox.astro";
import { LANGS, isFallback, tr, useT, type Lang } from "../../../lib/i18n";
import { getData } from "../../../lib/data";
import { ageText, dateRange, germanName, nameOf, pathFor, townName } from "../../../lib/format";
import { mapLink } from "../../../lib/maps";
import { FEATURE_ICON, UI_ICON, svg } from "../../../lib/icons";
import type { Event } from "../../../lib/types";
import { LANGUAGE } from "../../../content.config";
import { calInput } from "../../../lib/event-cal";
import { googleUrl } from "../../../lib/calendar";

export async function getStaticPaths() {
  const { events } = await getData();
  return LANGS.flatMap((lang) => events.map((e) => ({ params: { lang, id: e.id }, props: { event: e } })));
}
const { event: e } = Astro.props as { event: Event };
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const { region, placeById } = await getData();
const place = e.place ? placeById.get(e.place) : undefined;
const title = nameOf(e, lang);
const german = germanName(e, lang);
const town = townName(e.town, lang, region.towns);
const prec = e.geo.precision;
const yes = Object.entries(place?.facilities ?? {}).filter(([, v]) => v.status === "yes").map(([k]) => k);
const cal = await calInput(e, lang, Astro.site);
const translated = isFallback(e.title, lang) || isFallback(e.note, lang);
const map = mapLink(e, place);
---
<Base lang={lang} title={title} description={[dateRange(t, e), town].join(" · ")}>
  <article class="detail" data-lat={e.geo.lat} data-lon={e.geo.lon} data-precision={prec}>
    <a class="back" href={`/${lang}/`}>← {t("back")}</a>
    <div class="lead">
      <Stamp item={e} t={t} />
      <div>
        <h1>{title}</h1>
        {isFallback(e.title, lang) && <p class="orig">{t("translated")}</p>}
        {german && <p class="orig"><span lang="de">{german}</span> · {t("machine")}</p>}
      </div>
    </div>
    <ul class="facts">
      <li><span>📅</span><span>{dateRange(t, e)}{e.time && ` · ${e.time}`}</span></li>
      <li><span>📍</span><span>
        {place ? <a href={pathFor(lang, place)}>{nameOf(place, lang)}</a> : e.venue}{(place || e.venue) && town && ", "}{town}<span data-km></span>
        {prec !== "exact" && <><br /><small class="small">{t(`locNote.${prec === "area" && e.venue ? "venue" : prec}`, { town })}</small></>}
      </span></li>
      {e.price && <li><span>€</span><span>{e.price.free ? t("free") : tr(e.price.text, lang) || t("paid")}</span></li>}
      {e.ages && <li><span>👧</span><span>{ageText(t, e.ages)}</span></li>}
      {e.indoor != null && <li><span>{e.indoor ? "☂" : "☀"}</span><span>{e.indoor ? t("indoor") : t("outdoor")}</span></li>}
      <li><span>✓</span><span class="small">
        {e.trust.level === "community" ? t("trust.community") : <>{t(`trust.${e.trust.level}`)}{e.trust.source && ` · ${tr(e.trust.source, lang)}`}</>}
      </span></li>
    </ul>

    {/* How much German it needs: a guess from the title until parents tap one of the chips. */}
    <section class="speech-ask" data-lang-ask={e.id} data-votes={JSON.stringify(e.languageVotes ?? {})}>
      <h2>💬 {t("speechAsk.title")}</h2>
      <div class="speech-chips">
        {LANGUAGE.map((k) => (
          <button type="button" class:list={["chip", k, { current: e.language === k, guess: e.languageFrom === "guess" }]} data-lang-answer={k} aria-pressed="false">
            {t(`speech.${k}`)}<small data-n>{e.languageVotes?.[k] ? ` · ${e.languageVotes[k]}` : ""}</small>
          </button>
        ))}
      </div>
      <p class="small" data-lang-note>{
        e.languageFrom === "parents" ? t("speechAsk.parents", { n: Object.values(e.languageVotes ?? {}).reduce((a, b) => a + (b ?? 0), 0) })
        : e.languageFrom === "guess" ? t("speechAsk.guess")
        : !e.language ? t("speechAsk.unknown") : ""
      }</p>
    </section>
    {e.note && <p class="note">{tr(e.note, lang)}</p>}
    {translated && lang !== "de" && !isFallback(e.title, lang) && <p class="orig">{t("translated")}</p>}

    {place && yes.length > 0 && (
      <>
        <h2>{t("forFamilies")}</h2>
        <ul class="checks">
          {yes.map((f) => <li><span class="dot" set:html={svg(FEATURE_ICON[f])} /><span>{t(`features.${f}`)}</span></li>)}
        </ul>
      </>
    )}

    <div class="actions">
      {map && <a class="btn primary" href={map.href} target="_blank" rel="noopener">{map.search ? t("mapSearch") : t("route")}</a>}
      <button class="btn" type="button" data-save={e.id} aria-pressed="false"><Fragment set:html={svg(UI_ICON.saved, 'stroke-width="2" width="18" height="18"')} />{t("save")}</button>
      <details class="cal-menu">
        <summary class="btn"><Fragment set:html={svg(UI_ICON.calendar, 'stroke-width="2" width="18" height="18"')} />{t("cal.add")}</summary>
        <div class="cal-opts">
          <a href={googleUrl(cal)} target="_blank" rel="noopener">{t("cal.google")} ↗</a>
          <a href={`/${lang}/termine/${e.id}.ics`} download={`${e.id}.ics`}>{t("cal.ics")}</a>
        </div>
      </details>
      {e.website && <a class="btn" href={e.website} target="_blank" rel="noopener">{t("website")} ↗</a>}
    </div>
    {e.origin && <p class="small">{t("source")}: <a href={e.origin.url} target="_blank" rel="noopener">{e.origin.name}</a></p>}

    <GapBox item={e} t={t} />
    <VisitBox item={e} t={t} />
    <ReportBox item={e} t={t} />
  </article>
</Base>
