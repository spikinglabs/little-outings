---
import Base from "../../../layouts/Base.astro";
import Stamp from "../../../components/Stamp.astro";
import GapBox from "../../../components/GapBox.astro";
import ReportBox from "../../../components/ReportBox.astro";
import VisitBox from "../../../components/VisitBox.astro";
import { LANGS, isFallback, tr, useT, type Lang } from "../../../lib/i18n";
import { getData } from "../../../lib/data";
import { ageText, dateRange, pathFor, routeUrl, townName } from "../../../lib/format";
import { FEATURE_ICON, UI_ICON, svg } from "../../../lib/icons";
import type { Event } from "../../../lib/types";

export async function getStaticPaths() {
  const { events } = await getData();
  return LANGS.flatMap((lang) => events.map((e) => ({ params: { lang, id: e.id }, props: { event: e } })));
}
const { event: e } = Astro.props as { event: Event };
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const { region, placeById } = await getData();
const place = e.place ? placeById.get(e.place) : undefined;
const title = tr(e.title, lang);
const town = townName(e.town, lang, region.towns);
const prec = e.geo.precision;
const yes = Object.entries(place?.facilities ?? {}).filter(([, v]) => v.status === "yes").map(([k]) => k);
const translated = isFallback(e.title, lang) || isFallback(e.note, lang);
---
<Base lang={lang} title={title} description={[dateRange(t, e), town].join(" · ")}>
  <article class="detail" data-lat={e.geo.lat} data-lon={e.geo.lon} data-precision={prec}>
    <a class="back" href={`/${lang}/`}>← {t("back")}</a>
    <div class="lead">
      <Stamp item={e} t={t} />
      <div>
        <h1>{title}</h1>
        {isFallback(e.title, lang) && <p class="orig">{t("translated")}</p>}
      </div>
    </div>
    <ul class="facts">
      <li><span>📅</span><span>{dateRange(t, e)}{e.time && ` · ${e.time}`}</span></li>
      <li><span>📍</span><span>
        {place ? <a href={pathFor(lang, place)}>{place.name}</a> : e.venue}{(place || e.venue) && town && ", "}{town}<span data-km></span>
        {prec !== "exact" && <><br /><small class="small">{t(`locNote.${prec}`, { town })}</small></>}
      </span></li>
      {e.price && <li><span>€</span><span>{e.price.free ? t("free") : tr(e.price.text, lang) || t("paid")}</span></li>}
      {e.ages && <li><span>👧</span><span>{ageText(t, e.ages)}</span></li>}
      {e.indoor != null && <li><span>{e.indoor ? "☂" : "☀"}</span><span>{e.indoor ? t("indoor") : t("outdoor")}</span></li>}
      <li><span>✓</span><span class="small">
        {e.trust.level === "community" ? t("trust.community") : <>{t(`trust.${e.trust.level}`)}{e.trust.source && ` · ${tr(e.trust.source, lang)}`}</>}
      </span></li>
    </ul>
    {e.note && <p class="note">{tr(e.note, lang)}</p>}
    {translated && lang !== "de" && !isFallback(e.title, lang) && <p class="orig">{t("translated")}</p>}

    {place && yes.length > 0 && (
      <>
        <h2>{t("forFamilies")}</h2>
        <ul class="checks">
          {yes.map((f) => <li><span class="dot" set:html={svg(FEATURE_ICON[f])} /><span>{t(`features.${f}`)}</span></li>)}
        </ul>
      </>
    )}

    <div class="actions">
      {e.geo.lat != null && e.geo.lon != null && (
        <a class="btn primary" href={routeUrl(e.geo.lat, e.geo.lon)} target="_blank" rel="noopener">{prec === "area" ? t("routeTown") : t("route")}</a>
      )}
      <button class="btn" type="button" data-save={e.id} aria-pressed="false"><Fragment set:html={svg(UI_ICON.saved, 'stroke-width="2" width="18" height="18"')} />{t("save")}</button>
      {e.website && <a class="btn" href={e.website} target="_blank" rel="noopener">{t("website")} ↗</a>}
    </div>
    {e.origin && <p class="small">{t("source")}: <a href={e.origin.url} target="_blank" rel="noopener">{e.origin.name}</a></p>}

    <GapBox item={e} t={t} />
    <VisitBox item={e} t={t} />
    <ReportBox item={e} t={t} />
  </article>
</Base>
