---
// Add (URL /mitmachen/): an event, a family's own invite or a place, and fill in what's still missing about an outing.
// Every outing with a gap is rendered; the script below searches them and shows 30 at a time.
import Base from "../../layouts/Base.astro";
import GapForm from "../../components/GapForm.astro";
import AddFlow from "../../islands/AddFlow";
import { KINDS } from "../../content.config";
import { featuresFor } from "../../lib/features";
import { KIND_ICON, UI_ICON, svg } from "../../lib/icons";
import { LANGS, useT, type Lang } from "../../lib/i18n";
import { getData, getTasks } from "../../lib/data";
import { gapsOf } from "../../lib/gaps";
import { nameOf, pathFor, shortDate, townName } from "../../lib/format";
import { fold } from "../../lib/fold";

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const { region, eventById, placeById } = await getData();
const tasks = await getTasks();
// Town suggestions for "Suggest a place": region towns first, then every other town we know of.
// Any town can still be typed.
const regionTowns = region.towns.map((x) => x.name);
const knownTowns = [...new Set([...eventById.values(), ...placeById.values()].map((x) => x.town).filter((x): x is string => !!x && !regionTowns.includes(x)))]
  .sort((a, b) => a.localeCompare(b, "de"));
const suggestTowns = [...regionTowns, ...knownTowns].map((x) => [x, townName(x, lang, region.towns)]);
const itemOf = (task: (typeof tasks)[number]) => (task.type === "event" ? eventById.get(task.id)! : placeById.get(task.id)!);
// Each task lists its questions as short codes ("where", "fac:toys"); tasks.ts clones the matching form
// from #gap-forms when the task comes on screen. Thousands of full forms made this page megabytes heavy.
const gapCodes = (item: ReturnType<typeof itemOf>) => gapsOf(item).map((g) => (g.feature ? `${g.type}:${g.feature}` : g.type));
const allCodes = [...new Set(tasks.flatMap((task) => gapCodes(itemOf(task))))];
// Filters use what is known about each outing: its town and its dates.
const towns = [...new Set(tasks.map((task) => itemOf(task).town).filter(Boolean))]
  .sort((a, b) => townName(a, lang, region.towns).localeCompare(townName(b, lang, region.towns), lang));
const whenChips = [["", t("allKinds")], ["soon", t("when.soon")], ["later", t("tasksLater")],
  ...(tasks.some((task) => task.type === "place") ? [["place", t("places")]] : [])];
const keys = ["posterTitle", "posterSub", "posterBtn", "posterPick", "orPaste", "pastePh", "pasteBtn", "posterNote", "reading",
  "draftTitle", "pleaseCheck", "send", "answered", "answeredCheck", "answeredVote", "inboxSoon", "parseSoon", "parseFail", "sentEvent", "sendAnother", "editTitle", "editNote", "saveEdit", "cancelEdit", "sentEdit", "resendNote", "typeIt"];
// The "Sent as …" nickname line (src/islands/NickField.tsx) in both forms, and the hint after a first send.
const nickUi = { nickSentAs: t("nick.sentAs"), nickAnon: t("nick.anon"), nickChange: t("nick.change"), nickFirst: t("nick.first") };
const ui = { ...Object.fromEntries(keys.map((k) => [k, t(k)])), ...nickUi, field: t.group("field"), flow: t.group("flow") } as any;
const placeKeys = ["placeTitle", "placeSub", "placeBtn", "placeKind", "placeTown", "placeTownPh", "placeName", "placeStreet",
  "placeFeatures", "placeNote", "placeNotePh", "placeWebsite", "placeThanks", "placeAnother", "placeSentKind", "placeSentWhere", "placeEditTitle", "editNote", "saveEdit", "cancelEdit", "sentEdit", "resendNote", "send", "inboxSoon"];
const placeUi = { ...Object.fromEntries(placeKeys.map((k) => [k, t(k)])), ...nickUi };
---
<Base lang={lang} title={t("addTitle")} tab="add">
  <h1 class="page-title">{t("addTitle")}</h1>
  <p class="page-sub">{t("addSub")}</p>
  <AddFlow client:load lang={lang} ui={ui} place={{ ui: placeUi,
    kinds: KINDS.map((k) => [k, t(`kinds.${k}`)]) as [string, string][],
    features: Object.fromEntries(KINDS.map((k) => [k, featuresFor(k).map((f) => [f, t(`features.${f}`)] as [string, string])])),
    towns: suggestTowns as [string, string][] }}
    feed={{ ...t.group("feed"), inboxSoon: t("inboxSoon"), send: t("send") }} />

  <section class="section">
    <div class="section-head"><h2>{t("tasksTitle")}</h2><p data-task-count aria-live="polite"></p></div>
    <p class="page-sub">{t("tasksSub")}</p>
    <div class="task-tools">
      <label class="search">
        <span class="sr-only">{t("tasksSearch")}</span>
        <Fragment set:html={svg(UI_ICON.search, 'stroke-width="2"')} />
        <input id="task-q" type="search" placeholder={t("tasksSearchPh")} autocomplete="off" />
      </label>
      <div class="filters" role="group" aria-label={t("tasksFilter")}>
        {whenChips.map(([k, label]) => <button class="chip" type="button" data-when-chip={k} aria-pressed={k === "" ? "true" : "false"}>{label}</button>)}
      </div>
      <div class="filters">
        <label class="chip">📍
          <select id="task-town" aria-label={t("tasksTown")}>
            <option value="">{t("tasksAllTowns")}</option>
            {towns.map((town) => <option value={town}>{townName(town, lang, region.towns)}</option>)}
          </select>
        </label>
      </div>
    </div>
    <div class="grid" id="tasks" style="margin-top:12px">
      {tasks.length === 0 && <p class="empty">{t("empty")}</p>}
    </div>
    <!-- The tasks wait here, outside the live page, and the script moves in one page at a time. -->
    <template id="tasks-pool">
      {tasks.map((task) => {
        const item = itemOf(task);
        const title = nameOf(item, lang);
        const s = item.type === "event" ? shortDate(t, item.start) : null;
        return (
          <div class="task" hidden data-id={item.id} data-lat={item.geo.lat} data-lon={item.geo.lon} data-precision={item.geo.precision}
            data-type={item.type} data-town={item.town}
            data-start={item.type === "event" ? item.start : undefined} data-end={item.type === "event" ? item.end ?? item.start : undefined}
            data-q={fold([title, (item as { venue?: string }).venue, item.town, townName(item.town, lang, region.towns), s].filter(Boolean).join(" "))}>
            <a class="task-item" href={pathFor(lang, item)}>
              {s ? <span class="mini-stamp">{s}</span> : <span class="mini-stamp place" set:html={svg(KIND_ICON[(item as any).kind])} />}
              <span><b>{title}</b><span class="meta">{townName(item.town, lang, region.towns)}<span data-km></span></span></span>
            </a>
            <div data-gaps={gapCodes(item).join(" ")} />
          </div>
        );
      })}
    </template>
    <template id="gap-forms">
      {allCodes.map((c) => { const [type, feature] = c.split(":"); return <GapForm t={t} gapKey={`@:${c}`} type={type} feature={feature} />; })}
    </template>
    <p class="empty" data-task-empty hidden>{t("tasksNone")}</p>
    <button class="more-btn" type="button" data-task-more hidden></button>
    <script is:inline type="application/json" id="tasks-ui" set:html={JSON.stringify({ count: t.group("tasksCount"), more: t("mapShowMore") })} />
  </section>
  <script>
    import "../../scripts/tasks";
  </script>
</Base>
