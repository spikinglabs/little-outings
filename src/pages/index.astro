---
// The root picks a language from the browser and falls back to German.
const site = Astro.site?.toString().replace(/\/$/, "") ?? "";
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Little Outings · 小出游</title>
    <meta http-equiv="refresh" content="0; url=/de/" />
    <meta name="description" content="Ausflüge mit Kindern · Family outings · 小出游：德国带娃去哪儿" />
    <link rel="alternate" hreflang="de" href={`${site}/de/`} />
    <link rel="alternate" hreflang="en" href={`${site}/en/`} />
    <link rel="alternate" hreflang="zh-Hans" href={`${site}/zh/`} />
    <link rel="alternate" hreflang="x-default" href={`${site}/`} />
    <script is:inline>
      try {
        var l = (navigator.languages || [navigator.language || "de"]).map(function (x) { return x.slice(0, 2); })
          .find(function (x) { return x === "de" || x === "en" || x === "zh"; }) || "de";
        location.replace("/" + l + "/");
      } catch (e) {}
    </script>
  </head>
  <body><a href="/de/">Deutsch</a> · <a href="/en/">English</a> · <a href="/zh/">中文</a></body>
</html>
